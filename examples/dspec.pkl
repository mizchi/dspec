    new d.Rule {
      id = "DSPEC-DOGFOOD-TASK"
      kind = "obligation"
      text =
        text(
          "dogfood task は self spec、Runtime observation loop、実アプリ model の評価を再実行する",
          "The dogfood task reruns self-spec, Runtime observation loop, and real app model evaluation",
        )
      terms {
        "artifact.dogfood_task"
        "artifact.coverage_oracle"
        "artifact.domain_coverage_oracle"
        "artifact.drift_detector"
        "artifact.real_app_importer"
        "artifact.real_app_model"
        "artifact.reconciliation_oracle"
        "artifact.reverse_coverage_oracle"
        "artifact.app_profile"
        "artifact.app_profile_scenario"
        "artifact.app_profile_suite"
        "artifact.profile_scaffold_diff"
        "artifact.runtime_collector_fixture"
        "artifact.runtime_evidence_verifier"
        "artifact.spec_change_review"
        "artifact.spec_change_review_scaffold"
        "artifact.spec_reading_eval"
        "artifact.implementation_conformance"
        "artifact.spec_query"
      }
      must {
        new d.Clause {
          expr =
            "pkf.run(dogfood).checks(selfSpec + runtimeObservationLoop + realAppModel + realAppReconciliation + reverseCoverage + appProfile + appProfileScenario + appProfileSuite + scaffoldDiff + scaffoldApplyDryRun + scenarioCoverage + mutationScore + mutationScoreHoldouts + mutationScoreMetamorphic + changeReplayCorpus + specCompatibility + specChangeReviewScaffold + specChangeReview + specReadingEval + specReadingSuite + specReadingDigestRefresh + specReadingRunArtifact + evaluationMarkdown + implementationConformance + specQuery)"
          ast = new d.ExprAst {
            op = "atom"
            name = "dogfoodTaskRunsSelfEvaluation"
            args {
              "task"
            }
          }
          text =
            text(
              "pkf run dogfood は self spec、runtime observation loop、実アプリ model、reconciliation、reverse coverage、app profile、scenario、suite、scaffold diff/apply dry-run、scenario coverage、mutation score、holdout mutation score、metamorphic mutation score、change replay corpus、spec compatibility、spec change review scaffold、spec change review、spec reading eval、suite、coverage oracle、metamorphic check、file-relative path、digest refresh、run artifact、evaluation markdown、implementation conformance、spec query を検証する",
              "pkf run dogfood verifies the self spec, runtime observation loop, real app model, reconciliation, reverse coverage, app profile, scenarios, suites, scaffold diff/apply dry-run, scenario coverage, mutation score, holdout mutation score, metamorphic mutation score, change replay corpus, spec compatibility, spec change review scaffold, spec change review, spec reading eval, suite, coverage oracle, metamorphic check, file-relative path, digest refresh, run artifact, evaluation markdown, implementation conformance, and spec query",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#declares a dogfood task for self-spec evaluation"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "runtime"
          path = "Taskfile.pkl"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-SPEC-READING-EVAL"
      kind = "obligation"
      text =
        text(
          "spec reading eval は仕様から読み取れる主張の正誤を gold set として評価する",
          "Spec reading eval scores whether claims are readable from the spec as a gold set",
        )
      terms {
        "artifact.spec_reading_eval"
        "artifact.real_app_model"
        "artifact.coverage_oracle"
        "artifact.json_report"
        "artifact.markdown"
      }
      must {
        d.clause(
          "specReadingEval.cases.label in {entailed, contradicted, not-supported}",
          "評価 case は entailed / contradicted / not-supported の gold label を持つ",
          "evaluation cases carry entailed / contradicted / not-supported gold labels",
        )
        d.clause(
          "specReadingEval(entailed + contradicted).evidence resolves(term + rule + clause)",
          "entailed/contradicted case の evidence ref は term/rule/clause に解決できる",
          "evidence refs for entailed/contradicted cases resolve to terms, rules, or clauses",
        )
        d.clause(
          "specReadingEval.prompt.hides(goldLabels)",
          "サブエージェント用 prompt は gold label を隠す",
          "the subagent prompt hides gold labels",
        )
        d.clause(
          "specReadingEval.prompt.includes(rubric + localeParaphrases)",
          "サブエージェント用 prompt は三分類 rubric と locale 別 paraphrase を含む",
          "the subagent prompt includes the three-label rubric and locale-specific paraphrases",
        )
        d.clause(
          "specReadingEval.score(answers).reports(accuracy + perCaseStatus)",
          "回答 JSON は accuracy と case ごとの pass/fail に採点できる",
          "answer JSON can be scored into accuracy and per-case pass/fail status",
        )
        d.clause(
          "specReadingEval.score(answers).checks(answerEvidenceResolution + goldOverlap)",
          "回答 JSON の evidence は解決性と gold evidence との overlap を採点する",
          "answer JSON evidence is scored for resolvability and overlap with gold evidence",
        )
        d.clause(
          "specReadingEval.goldEvidence.digest.detects(staleRefs)",
          "gold evidence digest は参照先 term/rule/clause の stale 化を検出する",
          "gold evidence digests detect stale referenced terms, rules, or clauses",
        )
        d.clause(
          "specReadingEval.refreshDigests.dryRunAndApply",
          "gold evidence digest は dry-run で差分確認し、apply で Pkl fixture に反映できる",
          "gold evidence digests can be checked by dry-run and written back to Pkl fixtures with apply",
        )
        d.clause(
          "specReadingEvalSuite.evaluations.aggregate(sample + holdout)",
          "evaluation suite は sample と holdout の複数 gold set を集約して評価できる",
          "evaluation suites aggregate and evaluate multiple sample and holdout gold sets",
        )
        d.clause(
          "specReadingEvalSuite.coverage.requires(labels + evidenceKinds + modelKinds + tags + paraphraseLocales)",
          "evaluation suite coverage は label/evidence kind/model kind/tag/paraphrase locale の不足を検出する",
          "evaluation suite coverage detects missing labels, evidence kinds, model kinds, tags, and paraphrase locales",
        )
        d.clause(
          "specReadingEval.metamorphic.preserves(answerOrder + evidenceOrder + rationaleNoise)",
          "metamorphic 評価は回答順・evidence 順・rationale noise で score が変わらないことを検査する",
          "metamorphic evaluation checks that answer order, evidence order, and rationale noise preserve scores",
        )
        d.clause(
          "specReadingEval.metamorphic.rejects(flippedLabel)",
          "negative control は label 反転を失敗として検出する",
          "the negative control detects a flipped label as a failure",
        )
        d.clause(
          "specReadingEval.prompt.caseIds.notLeak(goldLabels)",
          "prompt の case id 近傍は gold label を漏らしてはならない",
          "prompt case IDs must not leak gold labels nearby",
        )
        d.clause(
          "specReadingEval.paths.resolveRelativeTo(ownerFile)",
          "evaluation の modelPath と suite の evaluations は所有 Pkl ファイル相対で解決される",
          "evaluation modelPath and suite evaluations resolve relative to the owning Pkl file",
        )
        d.clause(
          "specReadingEval.rubricVersion == cli.rubricVersion",
          "evaluation の rubricVersion は CLI の採点 rubric と一致しなければならない",
          "evaluation rubricVersion must match the CLI scoring rubric",
        )
        d.clause(
          "specReadingEval.score.writeRun.records(subagentPrompt + scoreReport)",
          "score は subagent prompt と採点結果を run artifact として書き出せる",
          "score can write the subagent prompt and score report as a run artifact",
        )
        d.clause(
          "specReadingEval.runner.process(stdinPrompt).stdoutAnswers && artifact.records(provider + model + digests + exit + rawOutput + score)",
          "provider-neutral runner は prompt/answers の process contract で実 agent を起動し、再現可能な採点 artifact を残す",
          "the provider-neutral runner invokes real agents through a prompt/answers process contract and records a reproducible scored artifact",
        )
        d.clause(
          "specReadingEval.markdownScore.records(subagentRun + goldFixCandidates)",
          "score Markdown は subagent run と gold 修正候補を記録する",
          "score Markdown records the subagent run and gold-fix candidates",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#evaluates spec reading gold sets")
        d.nodeCheck("test/cli.test.mjs#renders spec reading evaluation prompts without gold labels")
        d.nodeCheck("test/cli.test.mjs#renders localized spec reading prompts with paraphrases")
        d.nodeCheck("test/cli.test.mjs#scores spec reading evaluation answers")
        d.nodeCheck("test/cli.test.mjs#scores spec reading answer evidence")
        d.nodeCheck("test/cli.test.mjs#detects stale spec reading gold evidence digests")
        d.nodeCheck("test/cli.test.mjs#refreshes spec reading gold evidence digests")
        d.nodeCheck("test/cli.test.mjs#evaluates spec reading suites with holdout cases")
        d.nodeCheck("test/cli.test.mjs#resolves spec reading eval paths relative to the eval file")
        d.nodeCheck(
          "test/cli.test.mjs#resolves spec reading suite entries relative to the suite file",
        )
        d.nodeCheck("test/cli.test.mjs#reports spec reading suite coverage")
        d.nodeCheck("test/cli.test.mjs#rejects undercovered spec reading suites")
        d.nodeCheck("test/cli.test.mjs#detects spec reading rubric version mismatches")
        d.nodeCheck("test/cli.test.mjs#renders spec reading score reports for subagent runs")
        d.nodeCheck("test/cli.test.mjs#writes spec reading subagent run artifacts")
        d.nodeCheck("test/cli.test.mjs#runs provider-neutral spec reading agents and records reproducible artifacts")
        d.nodeCheck("test/cli.test.mjs#records invalid spec reading agent output as a failing artifact")
        d.nodeCheck("test/cli.test.mjs#keeps provider-neutral spec reading agent artifacts in sync")
        d.nodeCheck("test/cli.test.mjs#runs metamorphic spec reading evaluation")
        d.nodeCheck("test/cli.test.mjs#keeps spec reading evaluation JSON report fixture in sync")
        d.nodeCheck(
          "test/cli.test.mjs#keeps spec reading digest refresh JSON report fixture in sync",
        )
        d.nodeCheck("test/cli.test.mjs#keeps spec reading suite JSON report fixture in sync")
        d.nodeCheck(
          "test/cli.test.mjs#keeps spec reading suite coverage JSON report fixture in sync",
        )
        d.nodeCheck("test/cli.test.mjs#keeps metamorphic spec reading JSON report fixture in sync")
      }
      implementedBy {
        d.codeRef("dspec/Schema.pkl", "SpecReadingEvaluation")
        d.codeRef("dspec/Schema.pkl", "SpecReadingEvaluationSuite")
        d.codeRef("dspec/Schema.pkl", "SpecReadingCase")
        d.codeRef("dspec/Schema.pkl", "SpecReadingEvidence")
        d.codeRef("dspec/Schema.pkl", "SpecReadingAgentRunner")
