          expr = "verifyGenerated(model).validatesSyntax(alloy)"
          ast = new d.ExprAst {
            op = "atom"
            name = "validatesGeneratedAlloySyntax"
            args {
              "model"
            }
          }
          text =
            text(
              "verify-generated は Alloy 出力の module、sig、fact、assert、check を検証する",
              "verify-generated checks the Alloy module, sigs, fact, assert, and check",
            )
        }
        new d.Clause {
          expr = "hasTool(alloy6) -> verifyGenerated(model).executesAnalyzer(alloy)"
          ast = new d.ExprAst {
            op = "implies"
            children {
              new d.ExprAst {
                op = "atom"
                name = "hasTool"
                args {
                  "alloy6"
                }
              }
              new d.ExprAst {
                op = "atom"
                name = "executesGeneratedAlloyAnalyzer"
                args {
                  "model"
                }
              }
            }
          }
          text =
            text(
              "alloy6 が PATH にある場合は生成 Alloy を analyzer で実行する",
              "when alloy6 is on PATH, generated Alloy is executed by the analyzer",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#validates generated Alloy syntax"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#runs generated Alloy through analyzer when available"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "verifyGenerated"
        }
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "validateGeneratedAlloy"
        }
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "verifyGeneratedAlloyWithAnalyzer"
        }
      }
    }

