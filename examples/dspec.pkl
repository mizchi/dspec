          kind = "code"
          path = "src/cli.mjs"
          symbol = "emitFormalBackend"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-NIX-FORMAL-TOOLS"
      kind = "obligation"
      text =
        text(
          "Nix devShell は dspec 実行基盤と形式 backend ツールを提供する",
          "The Nix devShell provides dspec runtime and formal backend tools",
        )
      terms {
        "artifact.nix_dev_shell"
        "artifact.formal_backend"
        "artifact.generator"
      }
      must {
        new d.Clause {
          expr = "devShell.packages.includes(nodejs_24, pnpm, pkl, elan, z3, tlaplus, alloy6)"
          text =
            text(
              "devShell packages は Node/Pkl/Lean/Z3 と TLA+/Alloy ツールを含む",
              "devShell packages include Node/Pkl/Lean/Z3 and TLA+/Alloy tools",
            )
        }
        d.clause(
          "devshellSmoke(strict + requireStorePath).checks(requiredTools)",
          "devShell smoke は必須ツールの存在と host tool 漏れを検査する",
          "devShell smoke checks required tools and host-tool leakage",
        )
        d.clause(
          "verifyGenerated(requireFormalTools).requires(tlaSany + tlaTlc + alloyAnalyzer)",
          "verify-generated の formal required mode は TLA+/Alloy analyzer の skip を失敗にする",
          "verify-generated formal-required mode fails skipped TLA+/Alloy analyzer checks",
        )
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#declares formal backend tools in Nix devShell"
        }
        d.nodeCheck("test/cli.test.mjs#emits devShell tool smoke reports")
        d.nodeCheck("test/cli.test.mjs#requires formal backend tools when requested")
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "model"
          path = "flake.nix"
        }
        d.runtimeRef("Taskfile.pkl")
        d.codeRef("src/cli.mjs", "devshellSmokeReport")
        d.codeRef("src/cli.mjs", "assertVerifyGeneratedReport")
      }
    }

    new d.Rule {
      id = "DSPEC-PACKAGE-RELEASE"
      kind = "obligation"
      text =
        text(
          "v0.1 package は公開 API、互換性、OIDC release 手順を明示する",
          "The v0.1 package declares its public API, compatibility policy, and OIDC release procedure",
        )
      terms {
        "artifact.package_release"
        "artifact.cli"
        "artifact.checker"
      }
      must {
        d.clause(
          "npmPackage.files == {schema + cli + core + readme + license}",
          "npm package は宣言した公開境界だけを含む",
          "the npm package contains only the declared public boundary",
        )
        d.clause(
          "publish.uses(oidcTrustedPublisher + node24 + npm11) && !publish.uses(longLivedWriteToken)",
          "publish は Node 24/npm 11 の OIDC Trusted Publisher を使い、長期 write token を使わない",
          "publishing uses an OIDC Trusted Publisher on Node 24/npm 11 without a long-lived write token",
        )
        d.clause(
          "breakingPublicChange -> semverMinorBefore1_0 && changedSemantics -> newClauseAstSemanticsVersion",
          "1.0 前の破壊的変更と Clause.ast 意味論変更の versioning 方針を明示する",
          "versioning policy is explicit for pre-1.0 breaking changes and Clause.ast semantic changes",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/release.test.mjs#defines the v0.1 public package boundary")
        d.nodeCheck("test/release.test.mjs#defines explicit release and compatibility policy")
        d.nodeCheck("test/release.test.mjs#publishes through npm OIDC without a long-lived token")
      }
      implementedBy {
        d.modelRef("package.json")
        d.modelRef("release-please-config.json")
        d.modelRef(".release-please-manifest.json")
        d.modelRef(".github/workflows/release-please.yml")
        d.modelRef(".github/workflows/publish.yml")
        d.modelRef("docs/versioning.md")
        d.modelRef("docs/releasing.md")
        d.modelRef("LICENSE")
        d.codeRef("src/core/clause-ast.mjs", "CLAUSE_AST_SEMANTICS_VERSION")
      }
    }

    new d.Rule {
      id = "DSPEC-EXPR-TYPED-AST"
      kind = "invariant"
      text =
        text(
          "Clause.ast は operator ごとの意味論を持つ型付き式 AST として検証される",
          "Clause.ast is validated as a typed expression AST with per-operator semantics",
        )
      terms {
        "concept.clause_expr"
        "concept.expr_ast"
        "artifact.checker"
      }
      must {
        new d.Clause {
          expr = "clause.ast == null || clause.ast.shape.valid"
          ast = new d.ExprAst {
            op = "or"
            children {
              new d.ExprAst {
                op = "eq"
                args {
                  "clause.ast"
                  "null"
                }
              }
              new d.ExprAst {
                op = "atom"
                name = "validExprAst"
                args {
                  "clause.ast"
                }
              }
            }
          }
          text =
            text(
              "Clause.ast は未指定か、有効な式 AST 形状である",
              "Clause.ast is either absent or has a valid expression AST shape",
            )
        }
        new d.Clause {
          expr = "exprAst.operator.accepts_only_declared_fields"
          ast = new d.ExprAst {
            op = "atom"
            name = "acceptsOnlyDeclaredFields"
            args {
              "exprAst.operator"
            }
          }
          text =
            text(
              "各 operator は name/args/children の利用可否を固定する",
              "Each operator fixes which of name, args, and children it accepts",
            )
        }
        new d.Clause {
          expr = "model.clauseAstSemanticsVersion == checker.supportedClauseAstSemanticsVersion"
          ast = new d.ExprAst {
            op = "eq"
            args {
              "model.clauseAstSemanticsVersion"
              "checker.supportedClauseAstSemanticsVersion"
            }
          }
          text =
            text(
              "model が宣言する Clause.ast 意味論 version は checker が実装する version と一致する",
              "The Clause.ast semantics version declared by the model matches the version implemented by the checker",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#accepts typed Clause.ast"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects invalid typed Clause.ast"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects expr ast fields outside operator semantics"
        }
        d.nodeCheck("test/cli.test.mjs#rejects unsupported Clause.ast semantics versions")
        d.nodeCheck("test/clause-ast-core.test.mjs#defines Clause.ast semantics version 1.0")
        d.nodeCheck("test/clause-ast-core.test.mjs#evaluates every Clause.ast 1.0 operator consistently")
        d.nodeCheck("test/clause-ast-core.test.mjs#rejects evaluation with an unsupported semantics version")
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "model"
          path = "dspec/Schema.pkl"
          symbol = "ExprAst"
        }
        new d.ImplementationRef {
          kind = "code"
          path = "src/core/clause-ast.mjs"
          symbol = "validateClauseAst"
        }
        d.codeRef("src/core/clause-ast.mjs", "evaluateClauseAst")
        d.codeRef("src/core/clause-ast.mjs", "CLAUSE_AST_SEMANTICS_VERSION")
        d.modelRef("fixtures/unsupported-ast-semantics.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-EXPR-AST-PROJECTION"
      kind = "obligation"
      text =
        text(
          "生成器は Clause.ast を QuickCheck/TLA+/Lean の投影へ決定的に保存する",
          "Generators deterministically preserve Clause.ast in QuickCheck, TLA+, and Lean projections",
        )
      terms {
        "concept.expr_ast"
        "artifact.generator"
        "artifact.quickcheck"
        "artifact.formal_backend"
      }
      must {
        new d.Clause {
          expr = "emit(quickcheck|tla|lean, model).preserves(clause.ast + clauseAstSemanticsVersion)"
          ast = new d.ExprAst {
            op = "atom"
            name = "preservesClauseAst"
            args {
              "quickcheck"
              "tla"
              "lean"
            }
          }
          text =
            text(
              "QuickCheck/TLA+/Lean 出力は Clause.ast 由来の構造と意味論 version を含む",
              "QuickCheck, TLA+, and Lean outputs contain structure derived from Clause.ast and its semantics version",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#emits typed Clause.ast into backend projections"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "emitQuickcheck"
        }
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "exprToLean"
        }
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "exprToTla"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-DB-MODEL-PATTERN"
      kind = "obligation"
      text =
        text(
          "DB schema、transaction、invariant は typed pattern として記述され、backend に投影される",
          "DB schemas, transactions, and invariants are authored as a typed pattern and projected to backends",
        )
      terms {
        "artifact.db_model_pattern"
        "artifact.generator"
        "concept.db_invariant"
        "concept.db_transaction"
      }
      must {
        new d.Clause {
          expr = "patterns.db.transactions.write(table) -> transaction.preserves(touchedInvariant)"
          ast = new d.ExprAst {
            op = "atom"
            name = "dbTransactionPreservesInvariant"
            args {
              "transaction"
              "invariant"
            }
          }
          text =
            text(
              "DB transaction は書き込む table に関わる invariant の preserve 宣言を持つ",
              "DB transactions declare preservation for invariants touched by written tables",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#accepts DB model pattern"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#emits DB model pattern into backend projections"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#keeps generated DB invariant checks load-bearing"
        }
