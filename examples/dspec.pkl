  domainPacks {
    new d.DomainPack {
      id = "rbac"
      path = "dspec/domains/Rbac.pkl"
      helpers {
        new d.DomainPackHelper {
          id = "rbac.actor"
          symbol = "actor"
          returns = "term"
        }
        new d.DomainPackHelper {
          id = "rbac.role"
          symbol = "role"
          returns = "term"
        }
        new d.DomainPackHelper {
          id = "rbac.action"
          symbol = "action"
          returns = "term"
        }
        new d.DomainPackHelper {
          id = "rbac.resource"
          symbol = "resource"
          returns = "term"
        }
        new d.DomainPackHelper {
          id = "rbac.roleCan"
          symbol = "roleCan"
          returns = "rule"
          emitsTypedAst = true
          predicates {
            "hasRole"
            "allow"
          }
        }
        new d.DomainPackHelper {
          id = "rbac.onlyRoleCan"
          symbol = "onlyRoleCan"
          returns = "rule"
          emitsTypedAst = true
          predicates {
            "hasRole"
            "allow"
          }
        }
      }
    }
    new d.DomainPack {
      id = "tenant"
      path = "dspec/domains/Tenant.pkl"
