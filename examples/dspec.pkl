        d.codeRef("dspec/Schema.pkl", "AssuranceEvidenceClauseBinding")
        d.codeRef("src/core/assurance-evidence.mjs", "assuranceEvidenceSnapshot")
        d.codeRef("src/core/assurance-evidence.mjs", "CLAUSE_BACKEND_OPERATOR_SUPPORT")
