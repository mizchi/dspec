        d.codeRef("src/cli.mjs", "parseSpecCompatibilityArgs")
        d.codeRef("src/cli.mjs", "specChangeCompatUsage")
        d.codeRef("src/cli.mjs", "runSpecCompatibility")
        d.codeRef("src/cli.mjs", "specCompatibilityReport")
        d.codeRef("src/cli.mjs", "classifyTermChange")
