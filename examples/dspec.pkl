    new d.Rule {
      id = "DSPEC-SPEC-DIFF-IMPACT"
      kind = "obligation"
      text =
        text(
          "spec diff impact report は変更された term/rule/projection から生成 selector、owned artifact、実装参照への影響を返す",
          "Spec diff impact reports map changed terms, rules, and projections to affected generated selectors, owned artifacts, and implementation references",
        )
      terms {
        "artifact.impact_report"
        "artifact.json_report"
        "artifact.source_map"
        "artifact.projection"
        "concept.term"
        "concept.rule"
        "concept.verification_target"
      }
      must {
        d.clause(
          "impact.diff.detects(term, rule).added_removed_modified",
          "impact は term/rule の added/removed/modified を検出する",
          "impact detects added, removed, and modified terms and rules",
        )
        d.clause(
          "impact.changedTerm.rules -> generatedSelectors + implementationRefs",
          "変更された term は参照 rule、生成 selector、implementation refs に展開される",
          "changed terms expand to referencing rules, generated selectors, and implementation refs",
        )
        d.clause(
          "impact.projections -> changed + artifacts(action, path, locale) + regenerateCommand",
          "impact は projection 差分と regenerate/remove 対象 artifact、および再生成コマンドを返す",
          "impact returns projection changes, regenerate/remove artifact targets, and a regeneration command",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#emits spec diff impact reports")
        d.nodeCheck("test/cli.test.mjs#reports removed and regenerated artifacts for projection path changes")
        d.nodeCheck("test/cli.test.mjs#reports portable projection actions through spec-change review")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "parseImpactArgs")
        d.codeRef("src/cli.mjs", "impactReport")
        d.codeRef("src/cli.mjs", "projectionMaterializations")
        d.codeRef("src/cli.mjs", "projectionImpactReport")
        d.codeRef("src/cli.mjs", "diffItems")
        d.codeRef("src/cli.mjs", "sourceMapEntries")
        d.modelRef("fixtures/impact-before.pkl")
        d.modelRef("fixtures/impact-after.pkl")
        d.modelRef("fixtures/impact-projection-after.pkl")
        d.modelRef("fixtures/spec-change-review-projection.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-SPEC-COMPAT-CLASSIFIER"
      kind = "obligation"
      text =
        text(
          "spec compatibility classifier は before/after spec を compatible/breaking/narrowing/widening/unknown に分類する",
          "The spec compatibility classifier classifies before/after specs as compatible, breaking, narrowing, widening, or unknown",
        )
      terms {
        "artifact.compat_report"
        "artifact.json_report"
        "concept.rule"
        "concept.term"
      }
      must {
        d.clause(
          "classifySpecCompat(before, after).classification in {compatible, breaking, narrowing, widening, unknown}",
          "compatibility report は全体分類を stable enum として返す",
          "the compatibility report returns an overall stable enum classification",
        )
        d.clause(
          "classifySpecCompat(before, after).decisions.explain(eachChange)",
          "各変更は分類と理由を decision として説明する",
          "each change is explained as a decision with classification and reason",
        )
        d.clause(
          "removedApprovedRule -> breaking && addedObligation -> narrowing && addedPermission -> widening",
          "承認済み rule 削除は breaking、obligation 追加は narrowing、permission 追加は widening として扱う",
          "removed approved rules are breaking, added obligations are narrowing, and added permissions are widening",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#classifies spec compatibility changes")
        d.nodeCheck("test/cli.test.mjs#renders spec compatibility classification for review")
        d.nodeCheck("test/cli.test.mjs#keeps spec compatibility JSON report fixture in sync")
        d.nodeCheck(
          "test/cli.test.mjs#classifies spec compatibility through spec-change subcommands",
