    new d.Rule {
      id = "DSPEC-IMPLEMENTATION-CONFORMANCE"
      kind = "invariant"
      text =
        text(
          "implementation conformance は有限の型付き入力で Clause.ast の参照意味論と実装 adapter の結果を照合する",
          "Implementation conformance compares Clause.ast reference semantics and an implementation adapter over finite typed inputs",
        )
      terms {
        "artifact.implementation_conformance"
        "artifact.checker"
        "concept.expr_ast"
        "artifact.counterexample_normalizer"
      }
      must {
        new d.Clause {
          expr = "conformance.case.reference(clause.ast) == conformance.case.adapter(input)"
          ast = new d.ExprAst {
            op = "atom"
            name = "conformanceMatchesReference"
            args {
              "target"
              "input"
            }
          }
          text =
            text(
              "各 conformance case は参照評価と adapter の Boolean 結果を一致させる",
              "Each conformance case agrees between reference evaluation and the adapter Boolean result",
            )
        }
        d.clause(
          "conformance.failure.shrinksTo(declaredFailingCase)",
          "失敗時は宣言済み shrink 関係をたどった最小の failing case を返す",
          "On failure, the report returns the smallest failing case reachable through declared shrink links",
        )
        d.clause(
          "conformance.pass -> executedEvidence && conformance.pass != arbitraryImplementationProof",
          "conformance の pass は実行済み一致の証拠であり、任意の実装挙動に対する証明ではない",
          "A conformance pass is executed agreement evidence, not a proof of arbitrary implementation behavior",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#runs typed implementation conformance against Clause.ast reference semantics")
        d.nodeCheck("test/cli.test.mjs#reports the smallest declared conformance counterexample")
      }
      implementedBy {
        d.codeRef("dspec/Schema.pkl", "ConformanceCatalog")
        d.codeRef("dspec/Schema.pkl", "ConformanceTarget")
        d.codeRef("dspec/Schema.pkl", "ConformanceCase")
        d.codeRef("dspec/Schema.pkl", "ConformanceAtom")
        d.codeRef("src/core/conformance.mjs", "conformanceReport")
        d.codeRef("src/core/conformance.mjs", "validateConformanceModel")
        d.codeRef("src/cli.mjs", "implementationConformanceInvoker")
        d.codeRef("src/cli.mjs", "parseConformanceArgs")
        d.modelRef("fixtures/conformance-webapp.pkl")
        d.modelRef("fixtures/conformance-webapp-broken.pkl")
        d.modelRef("fixtures/conformance-webapp.mjs")
        d.modelRef("fixtures/conformance-webapp-broken.mjs")
        d.modelRef("docs/dogfooding-2026-07-15-conformance-query.md")
      }
    }

    new d.Rule {
      id = "DSPEC-SPEC-QUERY"
      kind = "obligation"
      text =
        text(
          "spec query は locale を保った決定的なモデル問い合わせと evidence 検証を提供する",
          "Spec query provides locale-preserving deterministic model lookup and evidence verification",
        )
      terms {
        "artifact.spec_query"
        "artifact.renderer"
        "artifact.i18n_contract"
        "artifact.spec_reading_eval"
      }
      must {
        d.clause(
          "query(rule|term|evidence|impact|clause, id).returns(localizedResult + resolvedEvidence)",
          "rule/term/evidence/impact/clause query は locale 化された結果と解決済み evidence を返す",
          "rule/term/evidence/impact/clause queries return a localized result and resolved evidence",
        )
        d.clause(
          "query(clause.mustNot).classification == contradicted && query(missing).classification == not-supported",
          "mustNot clause は contradicted、存在しない ID は not-supported として分類する",
          "mustNot clauses are classified as contradicted and missing IDs as not-supported",
        )
        d.clause(
          "query.answer.classificationAndEvidence.mustMatch(deterministicQueryResult)",
          "AI を含む回答は分類と evidence が決定的 query 結果に一致する場合だけ受理する",
          "An answer, including one produced by AI, is accepted only when its classification and evidence match the deterministic query result",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#queries localized claims and verifies an evidence-grounded answer")
        d.nodeCheck("test/cli.test.mjs#keeps unsupported query evidence from being accepted as an answer")
      }
      implementedBy {
        d.codeRef("src/core/spec-query.mjs", "querySpec")
        d.codeRef("src/core/spec-query.mjs", "verifySpecAnswer")
        d.codeRef("src/core/spec-query.mjs", "renderSpecQueryMarkdown")
        d.codeRef("src/cli.mjs", "parseQueryArgs")
        d.codeRef("src/cli.mjs", "queryAnswerReport")
        d.modelRef("fixtures/conformance-webapp.pkl")
        d.modelRef("fixtures/spec-query-answer-valid.json")
        d.modelRef("docs/semantic-model.md")
      }
    }

    new d.Rule {
      id = "DSPEC-REAL-APP-DOGFOOD"
      kind = "obligation"
      text =
        text(
          "実アプリ model は dspec の仕様マスターとして check/drift/domain/reconcile/reverse/profile を通過する",
          "The real app model passes check, drift, domain, reconcile, reverse, and profile gates as a dspec specification master",
        )
      terms {
        "artifact.real_app_model"
        "artifact.dogfood_task"
        "artifact.drift_detector"
        "artifact.domain_coverage_oracle"
        "artifact.reconciliation_oracle"
        "artifact.reverse_coverage_oracle"
        "artifact.app_profile"
        "artifact.app_profile_scenario"
        "artifact.app_profile_suite"
        "artifact.profile_scaffold_diff"
        "concept.verification_target"
      }
      must {
        d.clause(
          "examples/sample-webapp-2026.pkl.check == pass",
          "sample-webapp-2026 model は Pkl/schema/check の整合性を満たす",
          "the sample-webapp-2026 model satisfies Pkl, schema, and check consistency",
        )
        d.clause(
          "examples/sample-webapp-2026.pkl.drift == pass",
          "sample-webapp-2026 model の実装参照は実アプリ checkout に解決できる",
          "the sample-webapp-2026 model implementation references resolve against the real app checkout",
        )
        d.clause(
          "examples/sample-webapp-2026.pkl.domainCoverage == pass",
          "sample-webapp-2026 model の domain pattern 要素は approved rule に接地する",
          "the sample-webapp-2026 model domain pattern elements are grounded in approved rules",
        )
        d.clause(
          "reconcileRealApp(examples/sample-webapp-2026.pkl, importRealApp(sample-webapp-2026)) == pass",
          "sample-webapp-2026 model は実装 artifact から抽出した observed facts と一致する",
          "the sample-webapp-2026 model matches observed facts extracted from implementation artifacts",
        )
        d.clause(
          "reverseCoverage(importRealApp(sample-webapp-2026), examples/sample-webapp-2026.pkl) == pass",
          "実装 artifact から見える observed facts は sample-webapp-2026 model に表現される",
          "observed facts visible in implementation artifacts are represented in the sample-webapp-2026 model",
        )
        d.clause(
          "checkAppProfile(fixtures/sample-webapp-profile.pkl) == pass",
          "app profile は real app dogfood gate を一括で通過する",
          "the app profile passes the bundled real-app dogfood gates",
        )
        d.clause(
          "evaluateAppProfile(fixtures/sample-webapp-profile-scenarios.pkl) == pass",
          "scenario DSL 付き profile は明示した drift guard 評価を通過する",
          "the profile with scenario DSL passes its declared drift guard evaluation",
        )
        d.clause(
          "evaluateAppProfile(fixtures/sample-webapp-profile-extended-scenarios.pkl) == pass",
          "拡張 scenario DSL は release-gate/route/schema/workflow/data/runtime の drift guard 評価を通過する",
          "the extended scenario DSL passes release-gate, route, schema, workflow, data, and runtime drift guard evaluation",
        )
        d.clause(
          "coverageAppProfileScenarios(fixtures/sample-webapp-profile-extended-scenarios.pkl) == pass",
          "scenario coverage oracle は gate とカテゴリごとの false-positive/false-negative 評価不足を検出できる",
          "the scenario coverage oracle can detect missing gate-level and category-level false-positive and false-negative evaluation coverage",
        )
        d.clause(
          "scoreAppProfileMutations(fixtures/sample-webapp-profile-extended-scenarios.pkl).score == 1",
          "生成された app profile mutation は 12/12 検出され、detector の殺傷率を dogfood gate として固定する",
          "the generated app profile mutations are detected 12/12, locking detector kill rate as a dogfood gate",
        )
        d.clause(
          "coverageAppProfileScenarios(fixtures/sample-webapp-profile-route-scenarios.pkl) == pass",
          "requiredScenarioCategories 付き profile は対象カテゴリだけを scenario coverage に要求できる",
          "profiles with requiredScenarioCategories can require scenario coverage only for target categories",
        )
        d.clause(
          "coverageAppProfileScenarios(fixtures/sample-webapp-profile-route-missing-spec-scenario.pkl) == fail",
          "requiredScenarioCategories のカテゴリで spec-missing scenario が欠けると coverage oracle は失敗する",
          "the coverage oracle fails when a requiredScenarioCategories category lacks a spec-missing scenario",
        )
        d.clause(
          "coverageAppProfileScenarios(fixtures/sample-webapp-profile-underdeclared-categories.pkl) == fail",
          "model と observed app から推論されたカテゴリを requiredScenarioCategories が隠すと coverage oracle は失敗する",
          "the coverage oracle fails when requiredScenarioCategories hides categories inferred from the model and observed app",
        )
        d.clause(
          "coverageAppProfileScenarios(fixtures/sample-webapp-profile-route-ineffective-scenario.pkl) == fail",
          "宣言済みでも実行結果が pass しない scenario は coverage として数えない",
          "declared scenarios whose evaluated result does not pass are not counted as coverage",
        )
        d.clause(
          "checkAppProfileSuite(fixtures/sample-webapp-profile-suite.pkl) == pass",
          "profile suite は real app dogfood profile 群を registry として検証する",
          "the profile suite checks the real-app dogfood profiles as a registry",
        )
        d.clause(
          "scaffoldAppProfile(--diff, fixtures/sample-webapp-profile.pkl) == pass",
          "scaffold diff は既存 app profile が再生成下書きから drift していないことを確認する",
          "scaffold diff confirms the existing app profile has not drifted from the regenerated draft",
        )
        d.clause(
          "scaffoldAppProfile(--apply --dry-run, fixtures/sample-webapp-profile.pkl) == pass",
          "scaffold apply dry-run は既存 app profile を変更せずに更新候補がないことを確認する",
          "scaffold apply dry-run confirms there is no update candidate without mutating the existing app profile",
        )
        d.clause(
          "evaluateAppProfile(--markdown, fixtures/sample-webapp-profile-extended-scenarios.pkl) == pass",
          "scenario 評価は suggestion kind と mutation を含む人間レビュー用 Markdown としても生成できる",
          "scenario evaluation can also be generated as human-review Markdown with suggestion kind and mutation",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#dogfoods a real app model")
      }
      implementedBy {
        d.runtimeRef("Taskfile.pkl")
        d.modelRef("examples/sample-webapp-2026.pkl")
        d.modelRef("fixtures/sample-webapp-2026/apps/api/src/app.ts")
        d.modelRef("fixtures/sample-webapp-2026/packages/contracts/src/index.ts")
        d.modelRef("fixtures/sample-webapp-2026/.github/workflows/ci.yml")
        d.modelRef("fixtures/sample-webapp-2026/.github/workflows/weekly-review.yml")
        d.modelRef("fixtures/sample-webapp-2026/flaker.toml")
        d.modelRef("fixtures/reports/import-real-app-sample-webapp.json")
        d.modelRef("fixtures/reports/reconcile-real-app-sample-webapp.json")
        d.modelRef("fixtures/reports/reverse-coverage-sample-webapp.json")
        d.modelRef("fixtures/sample-webapp-profile.pkl")
        d.modelRef("fixtures/sample-webapp-profile-scenarios.pkl")
        d.modelRef("fixtures/sample-webapp-profile-extended-scenarios.pkl")
        d.modelRef("fixtures/sample-webapp-profile-route-scenarios.pkl")
        d.modelRef("fixtures/sample-webapp-profile-route-missing-spec-scenario.pkl")
        d.modelRef("fixtures/sample-webapp-profile-route-ineffective-scenario.pkl")
        d.modelRef("fixtures/sample-webapp-profile-underdeclared-categories.pkl")
        d.modelRef("fixtures/route-only-model.pkl")
        d.modelRef("fixtures/route-only-app/apps/api/src/app.ts")
        d.modelRef("fixtures/sample-webapp-profile-suite.pkl")
        d.modelRef("fixtures/reports/scaffold-app-profile-diff.json")
        d.modelRef("fixtures/reports/evaluate-app-profile-scenarios.json")
        d.modelRef("fixtures/reports/evaluate-app-profile-extended-scenarios.json")
        d.modelRef("fixtures/reports/evaluate-app-profile-extended-scenarios.md")
        d.modelRef("fixtures/reports/coverage-app-profile-scenarios.json")
        d.modelRef("fixtures/reports/score-app-profile-mutations.json")
        d.modelRef("fixtures/reports/evaluate-app-profile-suite.json")
        d.modelRef("fixtures/reports/check-app-profile-sample-webapp.json")
        d.modelRef("fixtures/reports/check-app-profile-suite.json")
        d.modelRef("fixtures/reports/spec-reading-eval-sample-webapp.json")
        d.modelRef("fixtures/reports/spec-reading-eval-refresh-stale.json")
        d.modelRef("fixtures/reports/spec-reading-eval-suite.json")
        d.modelRef("fixtures/reports/coverage-spec-reading-eval-suite.json")
        d.modelRef("fixtures/reports/metamorphic-spec-reading-eval.json")
      }
    }

    new d.Rule {
      id = "DSPEC-NIX-CI-GATE"
      kind = "obligation"
      text =
        text(
          "CI は portable fast gate と Nix formal gate を並列実行する",
          "CI runs portable fast and Nix formal gates in parallel",
        )
      terms {
        "artifact.nix_dev_shell"
        "artifact.formal_backend"
        "artifact.coverage_oracle"
      }
      must {
        d.clause(
          "githubActions.fast.run(pkf run check:fast).cache(pnpm + pkl + pkfireCas)",
          "fast job は portable gate を実行し、pnpm/Pkl/pkfire CAS を cache する",
          "the fast job runs portable gates and caches pnpm, Pkl, and the pkfire CAS",
        )
        d.clause(
          "githubActions.formal.run(nix develop path:$PWD -c pkf run check:formal).cache(nix)",
          "formal job は Nix devShell の tool smoke と required backend gate を Nix cache 付きで実行する",
          "the formal job runs devShell tool smoke and required backend gates with a Nix cache",
        )
        d.clause(
          "githubActions.jobs(fast, formal).parallel && pullRequest.supersededRun.cancelled",
          "fast/formal job は並列で、更新された PR の古い run は cancel する",
          "fast and formal jobs run in parallel and stale pull-request runs are cancelled",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#splits fast and formal GitHub Actions gates with caches")
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "runtime"
          path = ".github/workflows/check.yml"
        }
        d.runtimeRef("Taskfile.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-DOCUMENTED-CLI-EXAMPLES"
      kind = "obligation"
      text =
        text(
          "README/docs/Taskfile の CLI 例は公開 CLI surface に接地する",
          "CLI examples in README/docs/Taskfile are grounded in the public CLI surface",
        )
      terms {
        "artifact.command_registry"
        "artifact.command_example"
        "artifact.markdown"
        "artifact.dogfood_task"
      }
      must {
        d.clause(
          "cli.usage.generatedFrom(topLevelCommandRegistry)",
          "トップレベル usage は command registry から生成される",
          "top-level usage is generated from the command registry",
        )
        d.clause(
          "documentedCliExamples(readme + docs + taskfile).commands subsetOf cli.usage.commands",
          "ドキュメント内の CLI 例はトップレベル usage に存在するコマンドだけを使う",
          "documented CLI examples use only commands present in top-level usage",
        )
        d.clause(
          "documentedCliExamples(specChange).subcommands subsetOf {compat, scaffold, review}",
          "spec-change 例は公開 subcommand だけを使う",
          "spec-change examples use only public subcommands",
        )
        d.clause(
          "documentedCliExamples.safeSmoke.runs(help)",
          "ドキュメント由来の CLI 例は help smoke で安全に実行できる",
          "documented CLI examples can be safely smoke-run through help",
        )
        d.clause(
          "documentedCliExtractor.hasHoldout(fencedDspec + nodeOldpwd + pipe + inlineBackticks)",
          "CLI 例抽出器は fenced dspec、node $OLDPWD、pipe、inline backtick の holdout 形状で検証する",
          "the CLI example extractor is checked against holdout shapes for fenced dspec, node $OLDPWD, pipes, and inline backticks",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#defines top-level CLI commands through the command registry")
        d.nodeCheck(
          "test/cli.test.mjs#keeps documented CLI command examples on the live command surface",
        )
        d.nodeCheck("test/cli.test.mjs#smoke-runs documented CLI command examples through help")
        d.nodeCheck("test/cli.test.mjs#keeps documented CLI extractor covered by holdout shapes")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "topLevelCommandRegistry")
        d.codeRef("src/cli.mjs", "topLevelCommandHelp")
        d.codeRef("src/cli.mjs", "usage")
        d.codeRef("src/cli.mjs", "specChangeUsage")
        d.codeRef("test/cli.test.mjs", "documentedCliInvocations")
        d.codeRef("test/cli.test.mjs", "documentedCliHelpSmokeArgs")
        d.codeRef("test/cli.test.mjs", "appendFencedDspecInvocations")
        d.codeRef("test/cli.test.mjs", "cliUsageCommands")
        d.codeRef("test/cli.test.mjs", "specChangeUsageCommands")
        d.modelRef("fixtures/documented-cli-examples-holdout.md")
        d.modelRef("README.md")
        d.modelRef("docs/dogfooding-2026-07-10.md")
        d.modelRef("docs/usability-evaluation.md")
        d.modelRef("docs/semantic-model.md")
        d.runtimeRef("Taskfile.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-SEMANTICS-INFERENTIAL-SUPPORT"
      kind = "transition"
      text =
        text(
          "dspec の意味論は truth ではなく support/inferability として拡張する",
          "dspec semantics is extended as support/inferability rather than truth",
        )
      terms {
        "concept.inferon"
        "concept.support"
        "concept.rule"
      }
      must {
        new d.Clause {
          expr = "rule.claim.supported_by(checks + implementedBy + backend_proofs)"
          text =
            text(
              "Rule は CheckTarget と ImplementationRef と backend proof によって support される",
              "Rules are supported by CheckTargets, ImplementationRefs, and backend proofs",
            )
        }
      }
      reviewStatus = "review"
      rationale =
        "Inspired by proof-theoretic semantics: a dspec rule should behave like an inferon whose meaning is given by the base that supports it, not by an uninspected truth value."
    }

    new d.Rule {
      id = "DSPEC-EXPR-OPAQUE"
      kind = "non_goal"
      text =
        text(
          "現段階の Clause.expr は typed AST ではなく opaque string として扱う",
          "Clause.expr is currently treated as an opaque string, not a typed AST",
        )
      terms {
        "concept.clause_expr"
      }
      mustNot {
        new d.Clause {
          expr = "cli.parses_clause_expr_semantics"
          text = text("CLI が Clause.expr の意味論を解析する", "the CLI parses the semantics of Clause.expr")
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#accepts opaque Clause.expr text"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "model"
          path = "dspec/Schema.pkl"
          symbol = "Clause"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-INTENT-CLOSED-CONSTRUCTION"
      kind = "invariant"
      text =
        text(
          "Intent process は宣言済み Capability と ConstructionAuthority を通る Outcome だけを構築する",
          "Intent processes construct outcomes only through declared capabilities and construction authorities",
        )
      terms {
        "concept.intent_capability"
        "concept.intent_outcome"
        "concept.intent_process"
        "concept.intent_field"
        "concept.intent_refinement"
        "concept.construction_authority"
        "concept.intent_scenario"
      }
      must {
        d.clause(
          "intent.process.outcomes == intent.process.constructs subsetOf constructionAuthority",
          "Process の Outcome はすべて明示した construction authority を持つ",
          "Every Process outcome has an explicit construction authority",
        )
        d.clause(
          "intent.scenario.trace follows process.input and process.transition",
          "Scenario trace は Process の input state と transition を連続してたどる",
          "A Scenario trace follows continuous Process input states and transitions",
        )
        d.clause(
          "intent.elements == {capability.pkl.typecheck, capability.dspec.validate, outcome.intent-model-accepted, outcome.intent-model-accepted/output/validationReport, intent.validate-model, intent.validate-model/input/modelId, intent.validate-model/input/modelVersion, intent.validate-model/intent.validate-model-cli, intent.validate-model-accepts, intent-model-acceptance}",
          "自己仕様の Intent 要素は stable ID で rule に接地する",
          "The self-spec Intent elements are grounded in this rule by stable id",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#emits Intent processes into human and executable projections")
      }
      implementedBy {
        d.codeRef("dspec/Schema.pkl", "IntentModel")
        d.codeRef("dspec/Schema.pkl", "Process")
        d.codeRef("dspec/Schema.pkl", "ConstructionAuthority")
        d.codeRef("src/cli.mjs", "validateIntentModel")
        d.codeRef("src/cli.mjs", "intentProjection")
      }
      rationale =
        "Souther の closed construction path を、実装言語ではなく型付き Intent として取り込む。"
    }

    new d.Rule {
      id = "DSPEC-MBT-BOUNDARY"
      kind = "transition"
      text =
        text(
          "将来の pkl-mbt 実装は schema と fixture を維持したまま checker 境界を置き換える",
          "A future pkl-mbt implementation replaces the checker boundary while preserving schema and fixtures",
        )
      terms {
        "artifact.checker"
        "backend.pkl_mbt"
        "artifact.schema"
      }
      `when` {
        new d.Clause {
          expr = "checker.ported_to_pkl_mbt"
          text = text("checker を pkl-mbt 側へ移植する", "the checker is ported to pkl-mbt")
        }
      }
      must {
        new d.Clause {
          expr = "fixtures.expected_diagnostics_preserved"
          text = text("fixture の期待診断は維持される", "fixture diagnostics stay compatible")
        }
      }
      reviewStatus = "review"
      rationale =
        "The Node CLI is a thin prototype boundary. The durable contract should be the Pkl schema plus fixture-level diagnostics."
    }

    new d.Rule {
      id = "DSPEC-INTENT-GOAL-GRAPH"
      kind = "invariant"
      text =
        text(
          "Intent の Goal は Claim、保証タスク、実装 semantic binding まで追跡できる",
          "An Intent Goal is traceable through Claims, assurance tasks, and implementation semantic bindings",
        )
      terms {
        "concept.intent_goal"
        "concept.intent_claim"
        "concept.intent_assurance_task"
        "concept.intent_semantic_binding"
      }
      must {
        d.clause(
          "intent.goal.claims -> intent.claim.processes + assuranceTask + semanticBinding",
          "Goal の Claim は対象 Process、少なくとも一つの保証タスク、必要なら実装 binding を持つ",
          "A Goal Claim has declared Processes, at least one assurance task, and a required implementation binding",
        )
        d.clause(
          "intent.goalGraph.elements == {goal.intent-model-validation, claim.intent-model-validation, assurance.intent-model-validation-property, assurance.intent-model-validation-alloy, binding.intent-model-validation}",
          "自己仕様の Goal graph 要素は stable ID でこの rule に接地する",
          "The self-spec Goal graph elements are grounded in this rule by stable id",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#organizes natural-language Intent goals into claims, assurance tasks, and implementation bindings")
      }
      implementedBy {
        d.codeRef("dspec/schema/Claims.pkl", "IntentGoal")
        d.codeRef("dspec/schema/Claims.pkl", "IntentClaim")
        d.codeRef("dspec/schema/Claims.pkl", "IntentAssuranceTask")
        d.codeRef("dspec/schema/Claims.pkl", "IntentSemanticBinding")
        d.codeRef("src/cli.mjs", "validateIntentModel")
        d.codeRef("src/cli.mjs", "intentGraphReport")
      }
      rationale =
        "自然言語の目的を独立した正しさの根拠にせず、Claim ごとの決定的な検証・実装接続へ分解して drift を検出する。"
    }
  }

  patterns = new d.PatternCatalog {
    intent = new d.IntentModel {
      capabilities {
        new d.Capability {
          id = "capability.pkl.typecheck"
          kind = "external"
          text = text("Pkl schema を型検証する", "Type-check the Pkl schema")
        }
        new d.Capability {
          id = "capability.dspec.validate"
          kind = "read"
          text = text("Intent catalog を検証する", "Validate the Intent catalog")
        }
      }
      outcomes {
        new d.IntentOutcome {
          id = "outcome.intent-model-accepted"
          state = "state.intent-model-accepted"
          outputContract = new d.IntentDataContract {
            fields {
              new d.IntentField {
                id = "validationReport"
                type = "identifier"
                pattern = "^[a-z][a-z0-9-]*$"
              }
            }
            clauses {
              new d.Clause {
                expr = "validation.report.has_no_errors(validationReport)"
                ast = new d.ExprAst {
                  op = "atom"
                  name = "validationReportHasNoErrors"
                  args {
                    "validationReport"
                  }
                }
              }
            }
          }
          text = text("Intent model が受理された", "The Intent model is accepted")
        }
      }
      processes {
        new d.Process {
          id = "intent.validate-model"
          input = "state.intent-model-authored"
          inputContract = new d.IntentDataContract {
            fields {
              new d.IntentField {
                id = "modelId"
                type = "identifier"
              }
              new d.IntentField {
                id = "modelVersion"
                type = "string"
                pattern = "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-zA-Z0-9_.-]+)?$"
              }
            }
            clauses {
              new d.Clause {
                expr = "intent.model.has_version(modelId, modelVersion)"
                ast = new d.ExprAst {
                  op = "atom"
                  name = "intentModelHasVersion"
                  args {
                    "modelId"
                    "modelVersion"
                  }
                }
              }
            }
          }
          outcomes {
            "outcome.intent-model-accepted"
          }
          requires {
            "capability.pkl.typecheck"
            "capability.dspec.validate"
          }
          constructs {
            "outcome.intent-model-accepted"
          }
          transitions {
            new d.ProcessTransition {
              from = "state.intent-model-authored"
              to = "state.intent-model-accepted"
            }
          }
          implementedBy {
            d.codeRef("src/cli.mjs", "validateIntentModel")
          }
          refinements {
            new d.IntentRefinement {
              id = "intent.validate-model-cli"
              kind = "function"
              implementation = d.codeRef("src/cli.mjs", "validateIntentModel")
              inputBindings {
                new d.IntentFieldBinding { contractField = "modelId"; implementationField = "model.id" }
                new d.IntentFieldBinding { contractField = "modelVersion"; implementationField = "model.version" }
              }
              outcomeBindings {
                new d.IntentOutcomeBinding {
                  outcome = "outcome.intent-model-accepted"
                  fields {
                    new d.IntentFieldBinding { contractField = "validationReport"; implementationField = "validation.report" }
                  }
                }
              }
            }
          }
          text = text("Intent model を検証して受理する", "Validate and accept an Intent model")
        }
      }
      constructionAuthorities {
        new d.ConstructionAuthority {
          id = "intent.validate-model-accepts"
          process = "intent.validate-model"
          outcome = "outcome.intent-model-accepted"
        }
      }
      goals {
        new d.IntentGoal {
          id = "goal.daily-drift-review"
          priority = 20
          intents {
            "intent.validate-model"
          }
          claims {
            "claim.daily-drift-review"
          }
          nonGoals {
            text(
              "LLM は Pkl を自動編集せず、PR・Issue・仕様の正本を自動更新しない",
              "The LLM does not automatically edit Pkl, create PRs or issues, or update specification truth",
            )
          }
          text = text(
            "日次 batch で Intent・形式・実装 drift を検出して review する",
            "Detect and review Intent, formal, and implementation drift in a daily batch",
          )
        }
        new d.IntentGoal {
          id = "goal.formal-source-of-truth"
          priority = 0
          intents {
            "intent.validate-model"
          }
          claims {
            "claim.formal-source-of-truth"
          }
          nonGoals {
            text(
              "自然言語だけで仕様を規範化しない。対応範囲外の任意プログラムを Lean で証明済みとも主張しない",
              "Does not make natural language alone normative or claim arbitrary programs are Lean-proved outside declared support",
            )
          }
          text = text(
            "形式モデルを仕様の正本とし、文書・oracle・実装適合をそこから導出する",
            "Use the formal model as the specification master and derive documents, oracles, and implementation conformance from it",
          )
        }
        new d.IntentGoal {
          id = "goal.intent-model-validation"
          intents {
            "intent.validate-model"
          }
          claims {
            "claim.intent-model-validation"
          }
          nonGoals {
            text(
              "任意の実装が Intent model と意味論的に等価であることは証明しない",
              "Does not prove semantic equivalence between arbitrary implementations and the Intent model",
            )
          }
          text = text("型付き Intent model を一貫して受理する", "Consistently accept typed Intent models")
        }
      }
      claims {
        new d.IntentClaim {
          id = "claim.daily-drift-review"
          kind = "temporal"
          requiredImplementationBinding = false
          processes {
            "intent.validate-model"
          }
          text = text(
            "日次の決定的 packet は target ごとの Intent・形式・宣言済み実装観測の差異を収集し、LLM review は提案のみを出力する",
            "A daily deterministic packet collects per-target Intent, formal, and declared implementation-observation differences, while LLM review outputs proposals only",
          )
        }
        new d.IntentClaim {
          id = "claim.formal-source-of-truth"
          kind = "behavior"
          processes {
            "intent.validate-model"
          }
          text = text(
            "規範的意味は型付き形式モデルにあり、自然言語は生成された review 表現、実装は生成 oracle または明示した証跡を通過する",
            "Normative meaning is in the typed formal model; natural language is generated review text, and implementations pass generated or declared evidence-backed oracles",
          )
        }
        new d.IntentClaim {
          id = "claim.intent-model-validation"
          kind = "safety"
          processes {
            "intent.validate-model"
          }
          text = text(
            "妥当な Intent model は Goal graph の接続を含めて検証できる",
            "A valid Intent model is checked including its Goal graph links",
          )
        }
      }
      assuranceTasks {
        new d.IntentAssuranceTask {
          id = "assurance.daily-drift-review-property"
          claims {
            "claim.daily-drift-review"
          }
          kind = "property-test"
          backend = "node"
          assurance = "executed"
          target = new d.ImplementationRef {
            kind = "test"
            path = "test/daily-drift-packet.test.mjs"
          }
          text = text(
            "型付き target、実装観測、baseline、失敗時の証跡保持、read-only LLM review、評価セットの境界を Node test で検証する",
            "Check typed targets, implementation observations, baselines, retained failure evidence, the read-only LLM boundary, and the evaluation suite with Node tests",
          )
        }
        new d.IntentAssuranceTask {
          id = "assurance.formal-source-of-truth-property"
          claims {
            "claim.formal-source-of-truth"
          }
          kind = "property-test"
          backend = "node"
          assurance = "executed"
          target = new d.ImplementationRef {
            kind = "test"
            path = "test/cli.test.mjs"
          }
          text = text(
            "formal-first の文書境界と自己 Goal graph を Node test で検証する",
            "Check the formal-first documentation boundary and self Goal graph with a Node test",
          )
        }
        new d.IntentAssuranceTask {
          id = "assurance.formal-source-of-truth-lean"
          claims {
            "claim.formal-source-of-truth"
          }
          kind = "formal-model"
          backend = "lean"
          assurance = "proved"
          target = new d.ImplementationRef {
            kind = "proof"
            path = "generated/backends/DSpecSelf.lean"
          }
          assumptions {
            "Proof-level semantics are limited to declared Lean-supported Clause fragments"
          }
          text = text(
            "Lean は自己モデルの有限 support coverage invariant を証明し、意味論的主張は対応 fragment に限定する",
            "Lean proves the self-model finite support-coverage invariant while semantic claims remain limited to supported fragments",
          )
        }
        new d.IntentAssuranceTask {
          id = "assurance.intent-model-validation-property"
          claims {
            "claim.intent-model-validation"
          }
          kind = "property-test"
          backend = "node"
          assurance = "executed"
          target = new d.ImplementationRef {
            kind = "test"
            path = "test/cli.test.mjs"
          }
          text = text(
            "Goal graph の正負 fixture を Node property で検証する",
            "Check positive and negative Goal graph fixtures with a Node property",
          )
        }
        new d.IntentAssuranceTask {
          id = "assurance.intent-model-validation-alloy"
          claims {
            "claim.intent-model-validation"
          }
          kind = "formal-model"
          backend = "alloy"
          assurance = "bounded"
          target = new d.ImplementationRef {
            kind = "model"
            path = "examples/dspec.pkl"
          }
          assumptions {
            "Alloy checks bounded instances of generated relations"
          }
          text = text(
            "生成 Alloy model の有限インスタンスで Intent 構造を検査する",
            "Check Intent structure in bounded instances of the generated Alloy model",
          )
        }
      }
      semanticBindings {
        new d.IntentSemanticBinding {
          id = "binding.formal-source-of-truth"
          claims {
            "claim.formal-source-of-truth"
          }
          process = "intent.validate-model"
          kind = "otel-attribute"
          target = "dspec.spec.authority"
          value = "formal-model"
          text = text(
            "実装観測は形式モデルを仕様の権威として記録する",
            "Implementation observations record the formal model as specification authority",
          )
        }
        new d.IntentSemanticBinding {
          id = "binding.intent-model-validation"
          claims {
            "claim.intent-model-validation"
          }
          process = "intent.validate-model"
          kind = "otel-attribute"
          target = "dspec.intent.process"
          value = "intent.validate-model"
          text = text(
            "実装観測は検証 Process ID を記録する",
            "Implementation observations record the validation Process ID",
          )
        }
      }
      scenarios {
        new d.IntentScenario {
          id = "intent-model-acceptance"
          initialState = "state.intent-model-authored"
          steps {
            new d.IntentScenarioStep {
              process = "intent.validate-model"
              outcome = "outcome.intent-model-accepted"
            }
          }
          expectedState = "state.intent-model-accepted"
          text = text("型付き Intent model の受理", "Acceptance of a typed Intent model")
        }
      }
    }
  }

  decisions {
    new d.Decision {
      id = "ADR-SELF-0001"
      date = "2026-07-07"
      summary =
        text(
          "dspec 自身の仕様を Pkl モデルとして管理する",
          "Manage dspec's own specification as a Pkl model",
        )
      rationale =
        "Self-modeling turns the prototype into the first regression target for its own language and checker."
    }
    new d.Decision {
      id = "ADR-SELF-0002"
      date = "2026-07-07"
      summary =
        text(
          "Clause.expr は typed AST 化まで opaque string とする",
          "Keep Clause.expr as an opaque string until typed AST work",
        )
      rationale =
        "This avoids inventing a half-finished expression language before the stable model, i18n, and drift-detection boundaries are validated."
    }
    new d.Decision {
      id = "ADR-SELF-0003"
      date = "2026-07-16"
      summary =
        text(
          "dspec を汎用証明器ではなく、仕様・保証・双方向ドリフト検出ツールキットとして位置付ける",
          "Position dspec as a specification, assurance, and bidirectional drift-detection toolkit rather than a general prover",
        )
      rationale =
        "The authoritative model, adapter observations, reverse coverage, and claim-scoped evidence are valuable independently of universal program proof, so product documentation and the self-model must state that boundary explicitly."
    }
  }
}
