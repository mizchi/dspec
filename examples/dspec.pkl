    new d.Rule {
      id = "DSPEC-SPEC-CHANGE-REVIEW-SCAFFOLD"
      kind = "obligation"
      text =
        text(
          "spec change review scaffold は before/after model からレビュー用 Pkl ドラフトを決定的に生成する",
          "Spec change review scaffold deterministically generates a review Pkl draft from before/after models",
        )
      terms {
        "artifact.spec_change_review_scaffold"
        "artifact.spec_change_review"
        "artifact.compat_report"
        "artifact.breaking_change_policy"
        "artifact.report_fixture"
      }
      must {
        d.clause(
          "scaffoldSpecChangeReview(before, after).emits(SpecChangeReviewPkl)",
          "spec-change scaffold は保存して pkl eval できる SpecChangeReview Pkl を出力する",
          "spec-change scaffold emits SpecChangeReview Pkl that can be saved and pkl-evaluated",
        )
        d.clause(
          "scaffoldSpecChangeReview(outputPath).writes(PklFile) && importPath.relativeTo(outputPath)",
          "--output は保存先に応じて schema import path と model path を解決した Pkl ファイルを書き出す",
          "--output writes a Pkl file whose schema import path and model paths are resolved relative to the destination",
        )
        d.clause(
          "scaffoldSpecChangeReview(outputPath).prints(nextReviewCommand)",
          "--output 成功時は生成された review を検証する次の spec-change review コマンドを提示する",
          "--output success prints the next spec-change review command for the generated review",
        )
        d.clause(
          "reviewSpecChange(savedReview).independentOf(cwd)",
          "保存済み review は実行 cwd に依存せず同じ結果で検証できる",
          "saved reviews can be verified with the same result independent of execution cwd",
        )
        d.clause(
          "scaffoldSpecChangeReview(before, after).fills(expectedCompatibility + allowedCompatibility + requiredSteps)",
          "互換性分類から expectedCompatibility、allowedCompatibility、requiredSteps を埋める",
          "it fills expectedCompatibility, allowedCompatibility, and requiredSteps from compatibility classification",
        )
        d.clause(
          "scaffoldSpecChangeReview(breaking).requiresBreakingEvidence && leavesEvidenceEmpty",
          "breaking draft は必要証跡を宣言し、evidence は空のまま残して review gate に検出させる",
          "breaking drafts declare required evidence and leave evidence empty so the review gate detects omissions",
        )
        d.clause(
          "reviewSpecChange(breakingMissingEvidence).suggests(evidencePkl)",
          "breaking evidence 不足時は追加すべき evidence の Pkl 断片を提示する",
          "when breaking evidence is missing, spec-change review suggests Pkl evidence entries to add",
        )
        d.clause(
          "scaffoldSpecChangeReview.help.documents(output + breakingEvidence)",
          "spec-change scaffold の help は --output と breaking evidence の扱いを説明する",
          "spec-change scaffold help documents --output and breaking evidence behavior",
        )
        d.clause(
          "specChangeCommand.group(compat + scaffold + review) && onlyCanonicalCommandNames.exposed",
          "spec-change は compat/scaffold/review をまとめ、未リリースの長いコマンド名は公開しない",
          "spec-change groups compat, scaffold, and review and does not expose the unreleased long command names",
        )
        d.clause(
          "removedLegacySpecChangeCommands.rejectWith(unknownCommand)",
          "未リリースの旧 spec-change コマンド名は unknown command として拒否する",
          "unreleased legacy spec-change command names are rejected as unknown commands",
        )
        d.clause(
          "specChangeCommand.help.orders(compat -> scaffold -> review) && subcommands.haveLocalUsage",
          "spec-change help は compat -> scaffold -> review の順で案内し、各サブコマンドは局所 usage を持つ",
          "spec-change help presents compat -> scaffold -> review and each subcommand has local usage",
        )
        d.clause(
          "topLevelUsage.lists(specChange.compat -> specChange.scaffold -> specChange.review)",
          "トップレベル usage も spec-change を compat -> scaffold -> review の順で案内する",
          "top-level usage also presents spec-change as compat -> scaffold -> review",
        )
        d.clause(
          "fixtures.scaffoldSpecChangeReview == cli.scaffoldSpecChangeReview",
          "scaffold fixture は現在の CLI 出力と一致する",
          "the scaffold fixture matches the current CLI output",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#scaffolds spec change review drafts")
        d.nodeCheck(
          "test/cli.test.mjs#scaffolds breaking spec change review drafts with evidence policy",
        )
        d.nodeCheck("test/cli.test.mjs#keeps scaffolded spec change review draft fixture in sync")
        d.nodeCheck(
          "test/cli.test.mjs#writes scaffolded spec change review drafts to an output path",
        )
        d.nodeCheck(
          "test/cli.test.mjs#reports scaffolded spec change review output metadata as JSON",
        )
        d.nodeCheck("test/cli.test.mjs#renders breaking spec change evidence suggestions")
        d.nodeCheck("test/cli.test.mjs#reports breaking spec change evidence suggestions as JSON")
        d.nodeCheck("test/cli.test.mjs#renders scaffold spec change review command help")
        d.nodeCheck(
          "test/cli.test.mjs#scaffolds spec change reviews through spec-change subcommands",
        )
        d.nodeCheck("test/cli.test.mjs#renders spec-change command group help")
        d.nodeCheck(
          "test/cli.test.mjs#renders spec-change in normal workflow order in top-level usage",
        )
        d.nodeCheck("test/cli.test.mjs#renders spec-change subcommand help")
        d.nodeCheck("test/cli.test.mjs#renders spec-change subcommand usage for argument errors")
        d.nodeCheck("test/cli.test.mjs#rejects removed legacy spec-change command names")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "parseScaffoldSpecChangeReviewArgs")
        d.codeRef("src/cli.mjs", "usage")
        d.codeRef("src/cli.mjs", "run")
        d.codeRef("src/cli.mjs", "specChangeUsage")
