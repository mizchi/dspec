      terms {
        "concept.stable_id"
        "concept.localized_text"
      }
      must {
        new d.Clause {
          expr = "id.locale_independent"
          text = text("ID は locale に依存しない", "ids do not depend on locale")
        }
        new d.Clause {
          expr = "text.labels.by_locale"
          text =
            text(
              "自然言語表現は locale ごとの labels に入る",
              "natural-language text lives in per-locale labels",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#keeps stable ids across localized renders"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "model"
          path = "dspec/Schema.pkl"
          symbol = "LocalizedText"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-I18N-RENDER"
      kind = "obligation"
      text =
        text(
          "render は指定 locale の自然言語表示を生成する",
