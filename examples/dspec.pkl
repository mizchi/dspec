    new d.Rule {
      id = "DSPEC-DB-MIGRATION-MAPPING-WELL-FORMED"
      kind = "obligation"
      text =
        text(
          "DB migration mapping は preserve scope と from/to table に接地している",
          "DB migration mappings are grounded in the preserve scope and source/target tables",
        )
      terms {
        "artifact.db_model_pattern"
        "artifact.generator"
        "concept.db_invariant"
        "concept.db_migration"
        "concept.db_mapping"
      }
      must {
        new d.Clause {
          expr = "mapping.invariants subset migration.preserves"
          ast = new d.ExprAst {
            op = "atom"
            name = "dbMigrationMappingInvariantIsPreserved"
            args {
              "migration"
              "mapping"
              "invariant"
            }
          }
          text =
            text(
              "mapping が witness する invariant は migration.preserves に含まれる",
              "Invariants witnessed by a mapping are included in migration.preserves",
            )
        }
        new d.Clause {
          expr = "mapping.sourceExpr.mentions(fromTable) && mapping.targetExpr.mentions(toTable)"
          ast = new d.ExprAst {
            op = "atom"
            name = "dbMigrationMappingMentionsSourceAndTarget"
            args {
              "migration"
              "mapping"
            }
          }
          text =
            text(
              "mapping の sourceExpr/targetExpr は migration の from/to table を参照する",
