    new d.Rule {
      id = "DSPEC-BACKEND-PROJECTION-OWNERSHIP"
      kind = "obligation"
      text =
        text(
          "checked-in backend 生成物は kind 固有の single projection と provenance で所有される",
          "Checked-in backend artifacts are owned by kind-specific single projections and provenance",
        )
      terms {
        "artifact.generator"
        "artifact.projection"
        "artifact.formal_backend"
        "artifact.quickcheck"
        "artifact.source_map"
        "artifact.generated_manifest"
        "artifact.assurance_evidence_manifest"
      }
      must {
        d.clause(
          "projection.kind in {quickcheck, lean, alloy, tla, tla-cfg, source-map, generated-manifest} -> projection.matrix == single",
          "backend/source-map/生成マニフェストは各 kind に対応する single output と provenance を持つ",
          "backend, source-map, and generated-manifest outputs have one kind-specific output and provenance",
        )
        d.clause(
          "generatedCheck(projection) detects missing + stale + unexpected owned artifacts without writing",
          "generated check は所有する backend 生成物の欠落・古さ・未宣言 path を書き込みなしで検出する",
          "generated check detects missing, stale, and unexpected owned backend artifacts without writing",
        )
        d.clause(
          "impact(before, after).projectionArtifacts includes projectionKind + path + action for all materialized projections",
          "impact は全 projection の projectionKind/path/action を決定的に返す",
          "impact deterministically returns projection kind, path, and action for every materialized projection",
        )
        d.clause(
          "assuranceEvidenceManifest is execution evidence and is created or verified outside static projection generation",
          "AssuranceEvidenceManifest は実行時証跡であり、静的 projection の再生成では作成・上書きしない",
          "An AssuranceEvidenceManifest is execution evidence and is not created or overwritten by static projection generation",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#generates, checks, and repairs every deterministic backend projection kind")
        d.nodeCheck("test/projection-core.test.mjs#materializes localized and singleton backend projections with kind-specific emitters")
        d.nodeCheck("test/projection-core.test.mjs#rejects incompatible projection matrices and output extensions")
        d.nodeCheck("test/cli.test.mjs#keeps generated source map artifact in sync")
        d.nodeCheck("test/cli.test.mjs#keeps generated manifest artifact in sync")
      }
