      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "render"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-I18N-SEMANTIC-DRIFT"
      kind = "invariant"
      text =
        text(
          "i18n contract とレビュー済み translation lock は必須 locale、glossary、原文・訳文の変更を検出する",
          "The i18n contract and reviewed translation lock detect required-locale, glossary, source, and translation changes",
        )
      terms {
        "artifact.i18n_contract"
        "concept.localized_text"
        "concept.term"
      }
      must {
        d.clause(
          "localizedText.labels.cover(requiredLocales)",
          "すべての LocalizedText は requiredLocales の label を持つ",
          "every LocalizedText has labels for requiredLocales",
        )
        d.clause(
          "i18n.glossary.labels == vocabulary.term.text.labels",
          "glossary の label は vocabulary term の label と一致する",
          "glossary labels match the labels on vocabulary terms",
        )
        d.clause(
          "translationLock.sourceHash == localizedText.primaryLocale.currentHash",
          "原文を変えると、対応する翻訳のレビュー済み binding は stale になる",
          "changing source text makes its reviewed translation binding stale",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#accepts i18n contract coverage")
        d.nodeCheck("test/cli.test.mjs#rejects missing required localized labels")
        d.nodeCheck("test/cli.test.mjs#rejects i18n glossary label drift")
        d.nodeCheck("test/translation-lock-core.test.mjs#reports source, translation, and glossary changes independently")
      }
      implementedBy {
        d.codeRef("dspec/Schema.pkl", "I18nContract")
        d.codeRef("dspec/Schema.pkl", "I18nGlossaryEntry")
        d.codeRef("src/cli.mjs", "validateI18nContract")
        d.codeRef("src/cli.mjs", "walkLocalizedTexts")
        d.codeRef("src/core/translation-lock.mjs", "translationCheck")
        d.codeRef("src/cli.mjs", "runTranslation")
        d.modelRef("fixtures/i18n-contract.pkl")
        d.modelRef("fixtures/i18n-contract-missing-label.pkl")
        d.modelRef("fixtures/i18n-contract-glossary-mismatch.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-CHECK-DUPLICATES"
      kind = "prohibition"
      text =
        text(
          "同一モデル内の term/rule/decision ID 重複は受理しない",
          "Duplicate term, rule, or decision ids are rejected within one model",
        )
      terms {
        "artifact.checker"
        "concept.stable_id"
      }
      mustNot {
        new d.Clause {
          expr = "duplicate_id.accepted"
          text = text("重複 ID を正常系として受理する", "duplicate ids are accepted as valid")
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects duplicate rule ids"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "checkUnique"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-CHECK-REFERENCES"
      kind = "invariant"
      text =
        text(
          "ルールが参照する term と exception は同一モデル内で解決できる",
          "Terms and exceptions referenced by rules resolve within the same model",
        )
      terms {
        "artifact.checker"
        "concept.term"
        "concept.rule"
      }
      must {
        new d.Clause {
          expr = "rule.terms.all(termIds.has)"
          text = text("rule.terms は既存 term を参照する", "rule.terms refer to existing terms")
        }
        new d.Clause {
          expr = "rule.exceptions.all(ruleIds.has)"
          text = text("rule.exceptions は既存 rule を参照する", "rule.exceptions refer to existing rules")
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects unknown term references"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "validate"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-CHECK-APPROVED-VERIFIED"
      kind = "invariant"
      text =
        text(
          "approved な有効ルールは検証先または実装先を持つ",
          "Approved active rules have a verification or implementation target",
        )
      terms {
        "artifact.checker"
        "concept.rule"
        "concept.verification_target"
      }
      `when` {
        new d.Clause {
          expr = "rule.reviewStatus == approved && !rule.deprecated"
          text = text("ルールが approved かつ deprecated ではない", "a rule is approved and not deprecated")
        }
      }
      must {
        new d.Clause {
          expr = "rule.checks.size + rule.implementedBy.size > 0"
          text =
            text(
              "checks または implementedBy を少なくとも 1 つ持つ",
              "it has at least one check or implementation target",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects approved rules without verification targets"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "validate"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-CHECK-CONTRADICTION"
      kind = "prohibition"
      text =
        text(
          "同一ルール内で同じ clause identity を must と mustNot の両方に置かない",
          "The same clause identity is not allowed in both must and mustNot within one rule",
        )
      terms {
        "artifact.checker"
        "concept.clause_expr"
        "concept.expr_ast"
        "concept.rule"
      }
      mustNot {
        new d.Clause {
          expr = "same_clause_identity.in(must).and(mustNot)"
          text =
            text(
              "同じ expr または typed Clause.ast が must と mustNot に同時に現れる",
              "the same expr or typed Clause.ast appears in both must and mustNot",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects direct must and mustNot contradictions"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects typed AST must and mustNot contradictions"
        }
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "validate")
        d.codeRef("src/cli.mjs", "clauseIdentity")
        d.codeRef("src/cli.mjs", "exprAstKey")
        d.modelRef("fixtures/typed-ast-contradiction.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-DRIFT-IMPLEMENTATION-REF"
      kind = "invariant"
      text =
        text(
          "implementedBy の path と symbol は実装内で解決できる",
          "implementedBy path and symbol references resolve in the implementation",
        )
      terms {
        "artifact.drift_detector"
        "concept.verification_target"
      }
      must {
        new d.Clause {
          expr = "implementedBy.path.exists"
          text = text("implementedBy.path が存在する", "implementedBy.path exists")
        }
        new d.Clause {
          expr = "implementedBy.symbol == null || file.contains(symbolDeclaration)"
          text = text("symbol が指定された場合は宣言として存在する", "a specified symbol exists as a declaration")
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#detects missing implementation symbols"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "validateImplementationRefs"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-DRIFT-CHECK-TARGET"
      kind = "invariant"
      text =
        text(
          "CheckTarget は機械的に解決できる参照を持つ",
          "CheckTarget entries point to mechanically resolvable references",
        )
      terms {
        "artifact.drift_detector"
        "concept.verification_target"
      }
      must {
        new d.Clause {
          expr = "checkTarget.path.exists"
          text = text("CheckTarget の path が存在する", "the CheckTarget path exists")
        }
        new d.Clause {
          expr = "checkTarget.anchor == null || target.contains(anchor)"
          text = text("anchor が指定された場合は対象内に存在する", "a specified anchor exists in the target")
        }
        d.clause(
          "backendCheckTarget.anchor.resolvesAs(backendSpecificSymbol)",
          "Lean/TLA+/Alloy/Playwright/runtime の CheckTarget は backend 固有の symbol/source として解決される",
          "Lean, TLA+, Alloy, Playwright, and runtime CheckTargets resolve as backend-specific symbols or sources",
        )
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects check targets that do not resolve to test anchors"
        }
        d.nodeCheck("test/cli.test.mjs#resolves backend-aware drift targets")
        d.nodeCheck("test/cli.test.mjs#rejects missing backend-aware drift target symbols")
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "validateCheckTargets"
        }
        d.codeRef("src/cli.mjs", "hasLeanSymbol")
        d.codeRef("src/cli.mjs", "hasTlaSymbol")
        d.codeRef("src/cli.mjs", "hasAlloySymbol")
        d.codeRef("src/cli.mjs", "validateRuntimeCheckTarget")
        d.modelRef("fixtures/backend-aware-drift.pkl")
        d.modelRef("fixtures/backend-aware-drift-invalid.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-COVERAGE-APPROVED-CHECKED"
      kind = "invariant"
      text =
        text(
          "approved な有効ルールは自動検証ターゲットを持つ",
          "Approved active rules have automated check targets",
        )
      terms {
        "artifact.counterexample_normalizer"
        "artifact.coverage_oracle"
        "concept.rule"
        "concept.verification_target"
      }
      `when` {
        new d.Clause {
          expr = "rule.reviewStatus == approved && !rule.deprecated"
          text = text("ルールが approved かつ deprecated ではない", "a rule is approved and not deprecated")
        }
      }
      must {
        new d.Clause {
          expr = "rule.checks.exists(check => check.backend != manual && check.backend != runtime)"
          text =
            text(
              "manual/runtime 以外の CheckTarget を少なくとも 1 つ持つ",
              "it has at least one non-manual, non-runtime CheckTarget",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#reports coverage for dspec's self model"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects approved rules without load-bearing checks in coverage"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "validateCoverage"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-COVERAGE-CLAUSE-QUALITY"
      kind = "invariant"
      text =
        text(
          "clause-level coverage を要求する rule は各 clause を支える CheckTarget.covers を持つ",
          "Rules requiring clause-level coverage have CheckTarget.covers entries for every clause",
        )
      terms {
        "artifact.coverage_oracle"
        "artifact.clause_coverage"
        "concept.rule"
        "concept.verification_target"
      }
      coverage = "clause"
      `when` {
        d.clause(
          "rule.coverage == clause",
          "rule が clause-level coverage を要求する",
          "a rule requests clause-level coverage",
        )
      }
      must {
        d.clause(
          "rule.clauses.all(selector => automatedChecks.covers(selector))",
          "各 when/must/mustNot clause が自動 CheckTarget.covers で覆われる",
          "every when/must/mustNot clause is covered by automated CheckTarget.covers",
        )
        d.clause(
          "check.covers.all(selector => rule.clauses.has(selector))",
          "CheckTarget.covers は実在する clause selector だけを参照する",
          "CheckTarget.covers only references existing clause selectors",
        )
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#reports clause-level coverage"
          covers {
            "when[0]"
            "must[0]"
          }
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects clause-level coverage gaps"
          covers {
            "must[0]"
          }
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects invalid clause coverage selectors"
          covers {
            "must[1]"
          }
        }
      }
      implementedBy {
        d.codeRef("dspec/Schema.pkl", "CheckTarget")
        d.codeRef("dspec/Schema.pkl", "Rule")
        d.codeRef("src/cli.mjs", "ruleClauseSelectors")
        d.codeRef("src/cli.mjs", "validateCheckTargetCoverageSelectors")
        d.codeRef("src/cli.mjs", "validateCoverage")
        d.modelRef("fixtures/coverage-clause-covered.pkl")
        d.modelRef("fixtures/coverage-clause-missing.pkl")
        d.modelRef("fixtures/coverage-clause-invalid-selector.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-CHECK-ASSURANCE"
      kind = "invariant"
      text =
        text(
          "CheckTarget は保証の種類と証拠を明示し、coverage は必要な保証を検査する",
          "CheckTargets declare assurance kinds and evidence, and coverage checks required assurances",
        )
      terms {
        "artifact.coverage_oracle"
        "artifact.json_report"
        "concept.rule"
        "concept.verification_target"
      }
      must {
        d.clause(
          "check.assurances subsetOf {reference, executed, mutation-tested, bounded, proved}",
          "check の保証は reference/executed/mutation-tested/bounded/proved を区別する",
          "check assurance distinguishes reference, executed, mutation-tested, bounded, and proved",
        )
        d.clause(
          "check.assurances - {reference} subsetOf check.assuranceEvidence.keys",
          "reference より強い保証は証拠参照を持つ",
          "assurance stronger than reference has an evidence reference",
        )
        d.clause(
          "proved -> backend == lean && bounded -> backend in {tla, alloy}",
          "proved/bounded/mutation-tested は互換 backend にだけ宣言できる",
          "proved, bounded, and mutation-tested can only be declared on compatible backends",
        )
        d.clause(
          "rule.requiredAssurances subsetOf union(rule.automatedChecks.assurances)",
          "coverage は rule が要求する保証を automated CheckTarget 群が満たすか検査する",
          "coverage checks that automated CheckTargets satisfy each rule's required assurances",
        )
        d.clause(
          "reports.assurance == summary(activeApprovedRules.checks.assurances)",
          "check/drift/coverage report は保証の内訳を機械可読に出力する",
          "check, drift, and coverage reports expose machine-readable assurance summaries",
        )
        d.clause(
          "generated.quickcheck.rules preserves (requiredAssurances + checks.assurances + assuranceEvidence)",
          "QuickCheck 投影は保証要件・保証集合・証拠参照を保持し、独立した property として検査する",
          "the QuickCheck projection preserves assurance requirements, claims, and evidence and checks them as an independent property",
        )
        d.clause(
          "added(requiredAssurances) -> narrowing && removed(requiredAssurances) -> widening",
          "承認済み rule の必要保証の追加は narrowing、削除は widening と分類する",
          "adding assurance requirements to an approved rule is narrowing and removing them is widening",
        )
        d.clause(
          "normalize(assuranceFailure).source.ruleId == failedRule.id",
          "生成された保証不足の反例は元の rule と保証 property に正規化する",
          "generated assurance counterexamples normalize to the source rule and assurance property",
        )
      }
      reviewStatus = "approved"
      requiredAssurances {
        "executed"
      }
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#reports explicit assurance claims"
          assurances {
            "executed"
          }
          assuranceEvidence {
