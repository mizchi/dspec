    new d.Rule {
      id = "DSPEC-REAL-APP-RECONCILIATION"
      kind = "obligation"
      text =
        text(
          "real app reconciliation は手書き model と観測済み app facts の drift を検出する",
          "Real app reconciliation detects drift between the authored model and observed app facts",
        )
      terms {
        "artifact.reconciliation_oracle"
        "artifact.real_app_importer"
        "artifact.observed_app_facts"
        "artifact.real_app_model"
        "artifact.drift_detector"
        "artifact.failure_suggestion"
      }
      must {
        d.clause(
          "reconcileRealApp(model, observed).covers(patternElements)",
          "手書き model の Cloud/Data/Release/Runtime 要素が observed facts に存在することを確認する",
          "Cloud/Data/Release/Runtime elements in the authored model are checked against observed facts",
        )
        d.clause(
          "missingObservedFact -> report.status == fail",
          "期待した gate や flow が実装 artifact に見つからない場合は fail report になる",
          "missing expected gates or flows in implementation artifacts produce a failing report",
        )
        d.clause(
          "missingObservedFact -> suggestion.kind == implementation-missing",
          "仕様が期待する fact が観測されない場合、実装を戻すか仕様を更新する suggestion を返す",
          "when an expected fact is not observed, the report suggests restoring implementation or updating the spec",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#reconciles a real app model with imported facts")
        d.nodeCheck("test/cli.test.mjs#reports real app reconciliation drift")
        d.nodeCheck("test/cli.test.mjs#renders real app drift suggestions for CLI readers")
        d.nodeCheck("test/cli.test.mjs#keeps real app reconciliation fixture in sync")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "reconcileRealAppReport")
        d.codeRef("src/core/real-app.mjs", "realAppObservedDomain")
        d.codeRef("src/cli.mjs", "restoreObservedFactSuggestion")
        d.codeRef("src/cli.mjs", "restoreObservedReleaseGateSuggestion")
        d.codeRef("src/cli.mjs", "renderReportSuggestions")
        d.codeRef("src/cli.mjs", "renderRealAppReconciliationReport")
        d.modelRef("examples/sample-webapp-2026.pkl")
        d.modelRef("fixtures/reports/import-real-app-sample-webapp.json")
        d.modelRef("fixtures/reports/reconcile-real-app-sample-webapp.json")
      }
    }

    new d.Rule {
      id = "DSPEC-REAL-APP-REVERSE-COVERAGE"
      kind = "obligation"
      text =
        text(
          "reverse coverage は観測済み app facts が手書き model に吸われていることを確認する",
          "Reverse coverage checks that observed app facts are represented in the authored model",
        )
      terms {
        "artifact.reverse_coverage_oracle"
        "artifact.real_app_importer"
        "artifact.observed_app_facts"
        "artifact.real_app_model"
        "artifact.coverage_oracle"
        "artifact.failure_suggestion"
      }
      must {
        d.clause(
          "reverseCoverage(observed, model).uncovered == []",
          "observed facts 側にある Cloud/Data/Release/Runtime 要素が model 側に存在することを確認する",
          "Cloud/Data/Release/Runtime elements in observed facts are checked for representation in the model",
        )
        d.clause(
          "unmodeledObservedFact -> report.status == fail",
          "実装 artifact にだけ見える gate や flow は未モデル化 fact として fail report になる",
          "gates or flows visible only in implementation artifacts produce a failing unmodeled-fact report",
        )
        d.clause(
          "unmodeledObservedFact -> suggestion.kind == spec-missing",
          "実装で観測された fact が model にない場合、仕様へ追加するか実装から消す suggestion を返す",
          "when an observed fact is absent from the model, the report suggests modeling it or removing the implementation fact",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#reports reverse coverage for observed real app facts")
        d.nodeCheck("test/cli.test.mjs#reports unmodeled observed real app facts")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "reverseCoverageReport")
        d.codeRef("src/cli.mjs", "observedDomainCoverageElements")
        d.codeRef("src/cli.mjs", "modelReverseCoverageElements")
        d.codeRef("src/cli.mjs", "modelObservedFactSuggestion")
        d.codeRef("src/cli.mjs", "renderReportSuggestions")
        d.modelRef("examples/sample-webapp-2026.pkl")
        d.modelRef("fixtures/reports/import-real-app-sample-webapp.json")
        d.modelRef("fixtures/reports/reverse-coverage-sample-webapp.json")
      }
    }

    new d.Rule {
      id = "DSPEC-APP-PROFILE"
      kind = "obligation"
      text =
        text(
          "app profile は real app dogfood の検証 gate を型付き Pkl 設定として束ねる",
          "App profiles bundle real-app dogfood verification gates as typed Pkl configuration",
        )
      terms {
        "artifact.app_profile"
        "artifact.real_app_model"
        "artifact.real_app_importer"
        "artifact.reconciliation_oracle"
        "artifact.reverse_coverage_oracle"
        "artifact.failure_suggestion"
        "artifact.profile_scaffold"
        "artifact.profile_scaffold_diff"
        "artifact.drift_guard_evaluation"
        "artifact.app_profile_scenario"
        "artifact.app_profile_suite"
      }
      must {
        d.clause(
          "scaffoldAppProfile(modelPath, appRoot).emits(AppProfile)",
          "modelPath と appRoot から AI/人間が編集できる AppProfile Pkl 下書きを生成できる",
          "modelPath and appRoot can be scaffolded into an editable AppProfile Pkl draft",
        )
        d.clause(
          "scaffoldAppProfile(...).roundTrips(checkAppProfile)",
          "scaffold された AppProfile は保存後に check-app-profile を通過する",
          "a scaffolded AppProfile passes check-app-profile after being saved",
        )
        d.clause(
          "checkAppProfile(profile).runs(check + drift + domainCoverage + import + reconcile + reverseCoverage)",
          "profile は modelPath/appRoot/observedFacts と実行 gate を持ち、real app 評価を一括実行する",
          "a profile carries modelPath/appRoot/observedFacts and gates, then runs the real-app evaluation bundle",
        )
        d.clause(
          "checkAppProfile(profiles).aggregates(profileReports)",
          "複数 profile が渡された場合は profile ごとの report を aggregate report に束ねる",
          "multiple profiles are checked as an aggregate report of per-profile reports",
        )
        d.clause(
          "checkAppProfile(scaleFixture).preserves(aggregateReportShape)",
          "多数 profile の aggregate report 形は scale fixture で固定される",
          "large profile aggregate report shape is locked by a scale fixture",
        )
        d.clause(
          "checkAppProfileSuite(suite).loads(profileRegistry)",
          "profile registry suite は複数 AppProfile ファイルを仕様マスターとして束ねて検証する",
          "a profile registry suite checks multiple AppProfile files as a spec-master registry",
        )
        d.clause(
          "observedFacts.fixture == importRealApp(appRoot)",
          "observedFacts fixture は現在の import-real-app 出力と一致する必要がある",
          "the observedFacts fixture must match the current import-real-app output",
        )
        d.clause(
          "checkAppProfile(--fix, profile).refreshes(observedFacts)",
          "stale な observedFacts fixture は --fix で現在の import-real-app 出力に更新できる",
          "stale observedFacts fixtures can be refreshed with the current import-real-app output by passing --fix",
        )
        d.clause(
          "checkAppProfile(--fix --dry-run, profile).wouldFix(observedFacts)",
          "dry-run では observedFacts fixture を書き換えず、更新候補を wouldFix として返す",
          "dry-run reports observedFacts refresh candidates as wouldFix without writing the fixture",
        )
        d.clause(
          "checkAppProfile(profile).preserves(gate.suggestions)",
          "下位 gate の失敗 suggestion は app profile report でも失われない",
          "downstream gate failure suggestions are preserved in app profile reports",
        )
        d.clause(
          "checkAppProfile(--markdown, profile).renders(reviewTable)",
          "app profile report は人間レビュー用の Markdown table としても出力できる",
          "app profile reports can be rendered as a Markdown table for human review",
        )
        d.clause(
          "scaffoldAppProfile(--diff, profile).reports(scaffoldDrift)",
          "再生成した AppProfile 下書きと既存 profile の差分を JSON report として検出できる",
          "the regenerated AppProfile draft can be diffed against an existing profile as a JSON report",
        )
        d.clause(
          "scaffoldAppProfile(--apply --dry-run, profile).previews(scaffoldDrift)",
          "再生成した AppProfile 下書きは dry-run で既存 profile への更新候補として preview できる",
          "the regenerated AppProfile draft can be previewed as an update candidate for an existing profile with dry-run",
        )
        d.clause(
          "scaffoldAppProfile(--apply, profile).writes(AppProfile)",
          "明示 apply された AppProfile 下書きは出力先に相対 import を持つ Pkl として保存される",
          "an explicitly applied AppProfile draft is saved as Pkl with an import path relative to the output file",
        )
        d.clause(
          "evaluateAppProfile(profile).checks(falsePositive + falseNegative)",
          "baseline の false positive と injected drift の false negative を評価する",
          "baseline false positives and injected-drift false negatives are evaluated",
        )
        d.clause(
          "evaluateAppProfile(profile.scenarios).usesDeclaredScenarioDsl",
          "profile.scenarios は false-positive/false-negative 評価の mutation を型付き DSL として宣言できる",
          "profile.scenarios declares false-positive and false-negative mutations as a typed DSL",
        )
        d.clause(
          "evaluateAppProfile(profile.scenarios).covers(releaseGate + route + schema + workflow + dataStore + runtimeDependency)",
          "scenario DSL は release gate、route、contract schema、workflow、data store、runtime dependency の追加/削除 drift を表現できる",
          "the scenario DSL can express added and removed release gate, route, contract schema, workflow, data store, and runtime dependency drift",
        )
        d.clause(
          "evaluateAppProfile(--markdown, profile).renders(scenarioReviewTable + suggestionKind + mutation)",
          "scenario 評価 report の Markdown table は suggestion kind と mutation を含み、人間レビューで検出理由を失わない",
          "scenario evaluation Markdown tables include suggestion kind and mutation so human review keeps the detector rationale",
        )
        d.clause(
          "coverageAppProfileScenarios(profile).requires(gateCoverage + categoryCoverage)",
          "scenario coverage は gate 単位とカテゴリ単位で baseline false-positive と implementation-missing/spec-missing の false-negative 評価が通過済みか検査する",
          "scenario coverage checks gate-level and category-level baseline false-positive plus implementation-missing and spec-missing false-negative evaluations",
        )
        d.clause(
          "coverageAppProfileScenarios(profile).countsOnly(evaluateAppProfileScenario.status == pass)",
          "scenario coverage は宣言済み scenario ではなく、実行結果が pass した scenario だけを coverage として数える",
          "scenario coverage counts only scenarios whose evaluated result passed, not merely declared scenarios",
        )
        d.clause(
          "profile.requiredScenarioCategories.scopes(categoryCoverage) && includes(inferredScenarioCategories)",
          "profile.requiredScenarioCategories は対象アプリに必要なカテゴリだけへ絞れるが、model と observed app から推論されたカテゴリを隠せない",
          "profile.requiredScenarioCategories can narrow category coverage to target categories but cannot hide categories inferred from the model and observed app",
        )
        d.clause(
          "scoreAppProfileMutations(profile).generates(requiredScenarioCategories x suggestionKinds)",
          "mutation score は required scenario category ごとに implementation-missing/spec-missing の drift を決定的に生成する",
          "mutation score deterministically generates implementation-missing and spec-missing drift for each required scenario category",
        )
        d.clause(
          "scoreAppProfileMutations(profile).score == detected / generated && includes(shrinks)",
          "mutation score は検出できた generated mutation の割合と shrink 候補を report する",
          "mutation score reports the detected/generated ratio and shrink candidates",
        )
        d.clause(
          "scoreAppProfileMutations(holdoutProfiles).guardsAgainst(sampleOverfit)",
          "holdout profile は sample app 以外の route/schema/workflow 名で mutation generator の過学習を検出する",
          "holdout profiles detect mutation-generator overfitting with route, schema, and workflow names outside the sample app",
        )
        d.clause(
          "scoreAppProfileMutations(profile).witnesses.stableUnder(orderPermutation + unrelatedObservedFacts)",
          "mutation score の generated witness は observed fact の順序変更や無関係な追加 fact で変わらない",
          "mutation-score generated witnesses remain stable under observed-fact order permutations and unrelated added facts",
        )
        d.clause(
          "replayAppProfileChanges(corpus).matches(expectedDriftLabels)",
          "app change replay corpus は before/after の実アプリ差分を no-drift/implementation-missing/spec-missing の期待ラベルと照合する",
          "an app change replay corpus compares before/after real-app diffs with expected no-drift, implementation-missing, and spec-missing labels",
        )
        d.clause(
          "evaluateAppProfileSuite(suite).aggregates(profileEvaluations)",
          "profile suite は各 profile の scenario 評価結果を aggregate evaluation report に束ねる",
          "a profile suite aggregates each profile's scenario evaluation report",
        )
      }
      reviewStatus = "approved"
      requiredAssurances {
        "executed"
        "mutation-tested"
      }
      checks {
        d.nodeCheck("test/cli.test.mjs#checks app profiles as a dogfood bundle")
        d.nodeCheck("test/cli.test.mjs#checks multiple app profiles as an aggregate bundle")
        d.nodeCheck("test/cli.test.mjs#checks app profile suites from a registry")
        d.nodeCheck("test/cli.test.mjs#renders app profile reports as markdown")
        d.nodeCheck("test/cli.test.mjs#scaffolds app profiles for AI authoring")
        d.nodeCheck("test/cli.test.mjs#checks scaffolded app profiles after saving them")
        d.nodeCheck("test/cli.test.mjs#diffs scaffolded app profiles against existing profiles")
        d.nodeCheck("test/cli.test.mjs#reports scaffolded profile drift as JSON")
        d.nodeCheck("test/cli.test.mjs#applies scaffolded app profile updates safely")
        d.nodeCheck(
          "test/cli.test.mjs#evaluates app profile false-positive and false-negative guards",
        )
        d.nodeCheck("test/cli.test.mjs#evaluates declared app profile scenarios")
        d.nodeCheck("test/cli.test.mjs#evaluates extended app profile scenario patterns")
        d.nodeCheck("test/cli.test.mjs#renders app profile evaluation reports as markdown")
        d.nodeCheck("test/cli.test.mjs#reports app profile scenario coverage")
        d.nodeCheck("test/cli.test.mjs#scopes app profile scenario coverage to required categories")
        d.nodeCheck(
