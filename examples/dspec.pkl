          returns = "rule"
          emitsTypedAst = true
          predicates {
            "routeUsesSchema"
          }
        }
        new d.DomainPackHelper {
          id = "webapp.workflowHasGate"
          symbol = "workflowHasGate"
          returns = "rule"
          emitsTypedAst = true
          predicates {
            "workflowHasGate"
          }
        }
      }
    }
  }

  i18n = new d.I18nContract {
    requiredLocales {
      "ja"
      "en"
    }
    glossary {
      new d.I18nGlossaryEntry {
        term = "artifact.i18n_contract"
        labels {
          ["ja"] = "i18n semantic contract"
          ["en"] = "i18n semantic contract"
        }
      }
      new d.I18nGlossaryEntry {
        term = "concept.localized_text"
        labels {
          ["ja"] = "多言語テキスト"
          ["en"] = "localized text"
        }
      }
      new d.I18nGlossaryEntry {
        term = "concept.term"
        labels {
          ["ja"] = "語彙 term"
          ["en"] = "vocabulary term"
        }
      }
    }
  }

  rules {
    new d.Rule {
      id = "DSPEC-SCHEMA-TYPED"
      kind = "obligation"
      text =
        text(
          "仕様モデルは Pkl schema で型検査される",
          "Spec models are type-checked by the Pkl schema",
        )
      terms {
        "artifact.pkl_model"
        "artifact.schema"
        "backend.pkl"
      }
      `when` {
        new d.Clause {
          expr = "pkl.file.authored"
          text = text("Pkl 仕様ファイルが作成される", "a Pkl spec file is authored")
        }
      }
      must {
        new d.Clause {
          expr = "pkl.eval(model).ok"
          text =
            text("Pkl evaluator が schema 制約を通す", "the Pkl evaluator accepts the schema constraints")
        }
      }
      reviewStatus = "approved"
      checks {
