    new d.Rule {
      id = "DSPEC-SPEC-CHANGE-REVIEW"
      kind = "obligation"
      text =
        text(
          "spec change review は仕様変更時の check、impact、互換性分類、coverage gate を一つの手続き成果物として検証する",
          "Spec change review verifies check, impact, compatibility classification, and coverage gates as one procedure artifact for spec changes",
        )
      terms {
        "artifact.spec_change_review"
        "artifact.compat_report"
        "artifact.impact_report"
        "artifact.coverage_oracle"
        "artifact.json_report"
        "artifact.breaking_change_policy"
      }
      must {
        d.clause(
          "reviewSpecChange(review).runs(checkBefore + checkAfter + impact + compatibility + breakingPolicy + coverageAfter)",
          "spec-change review は before/after check、impact、compatibility、breaking policy、after coverage を実行する",
          "spec-change review runs before/after checks, impact, compatibility, breaking policy, and after coverage",
        )
        d.clause(
          "reviewSpecChange(review).gates(expectedCompatibility + allowedCompatibility)",
          "expectedCompatibility と allowedCompatibility は互換性分類を gate する",
          "expectedCompatibility and allowedCompatibility gate the compatibility classification",
        )
        d.clause(
          "reviewSpecChange(review).breaking -> requires(migrationPlan + deprecationPlan + rolloutPlan + ownerApproval)",
          "breaking change は migration、deprecation、rollout、owner approval の証跡を要求する",
          "breaking changes require migration, deprecation, rollout, and owner-approval evidence",
        )
        d.clause(
          "reviewSpecChange(review).evidence.ref resolves(file + markdownAnchor)",
          "証跡 ref は repository 内の file と Markdown anchor へ解決できる",
          "evidence refs resolve to repository files and Markdown anchors",
        )
        d.clause(
          "reviewSpecChange(review).emits(jsonReport + markdownReview)",
          "変更レビューは機械可読 JSON と人間可読 Markdown の両方で出力できる",
          "change review can emit both machine-readable JSON and human-readable Markdown",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#reviews a spec change procedure")
