    new d.Rule {
      id = "DSPEC-EMIT-MARKDOWN"
      kind = "obligation"
      text =
        text(
          "仕様モデルから人間が読める Markdown を決定的に生成する",
          "A human-readable Markdown document is generated deterministically from the spec model",
        )
      terms {
        "artifact.generator"
        "artifact.markdown"
        "concept.stable_id"
      }
      must {
        new d.Clause {
          expr = "emit(markdown, model).deterministic"
          text = text("同じモデルから同じ Markdown が生成される", "the same model yields the same Markdown")
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#emits deterministic markdown"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "emitMarkdown"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-EMIT-QUICKCHECK"
      kind = "obligation"
      text =
        text(
          "仕様モデルから generator と shrink を持つ QuickCheck 形式を決定的に生成する",
          "A QuickCheck-style format with generators and shrinkers is generated deterministically from the spec model",
        )
      terms {
        "artifact.generator"
        "artifact.quickcheck"
        "concept.rule"
      }
      must {
        new d.Clause {
          expr = "quickcheck.output.includes(generator) && quickcheck.output.includes(shrinker)"
          text =
            text(
              "出力は generator と shrinker を含む",
              "the output contains both generators and shrinkers",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#emits deterministic quickcheck with shrink"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "emitQuickcheck"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-EMIT-FORMAL-BACKENDS"
      kind = "obligation"
      text =
        text(
