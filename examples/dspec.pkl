          symbol = "validateDbModel"
        }
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "dbProjection"
        }
        new d.ImplementationRef {
          kind = "model"
          path = "fixtures/db-model.pkl"
        }
        new d.ImplementationRef {
          kind = "model"
          path = "fixtures/db-model-missing-preserve.pkl"
        }
      }
    }

    new d.Rule {
      id = "DSPEC-DB-SCHEMA-IMPORTER"
      kind = "obligation"
      text =
        text(
