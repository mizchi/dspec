    new d.Rule {
      id = "DSPEC-REAL-APP-IMPORTER"
      kind = "obligation"
      text =
        text(
          "real app importer は実装 artifact から観測済み app facts を決定的に抽出する",
          "The real app importer deterministically extracts observed app facts from implementation artifacts",
        )
      terms {
        "artifact.real_app_importer"
        "artifact.observed_app_facts"
        "artifact.real_app_model"
        "artifact.json_report"
      }
      must {
        d.clause(
          "importRealApp(root).observes(routes + contracts + workflows + qualityConfig + infrastructure)",
          "Hono route、Zod schema、GitHub Actions、quality config、IaC 宣言を観測 fact として抽出する",
          "Hono routes, Zod schemas, GitHub Actions, quality config, and IaC declarations are extracted as observed facts",
        )
        d.clause(
          "importRealApp(root).pklFragment.canSeed(patterns)",
          "observed facts は未確認の安全性を true にせず Pkl pattern model の下書きへ変換できる",
          "observed facts seed a Pkl pattern model without turning unknown safety guarantees into true",
        )
        d.clause(
          "evaluateRealAppImport(goldFacts).precision == 1 && evaluateRealAppImport(goldFacts).recall == 1",
          "別プロジェクト由来の typed gold facts で importer の precision と recall を回帰検証する",
          "typed gold facts derived from other projects regress importer precision and recall",
        )
        d.clause(
          "realAppCore.hasNoFilesystemOrPklProcessDependency && cli.infrastructure == realAppCore.infrastructure",
          "正規化・評価・domain 投影は filesystem と Pkl process に依存しない core API とし、CLI と同一結果を返す",
          "normalization, evaluation, and domain projection form a core API without filesystem or Pkl process dependencies and remain identical to CLI output",
        )
      }
      reviewStatus = "approved"
      checks {
