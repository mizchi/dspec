    new d.Rule {
      id = "DSPEC-COUNTEREXAMPLE-NORMALIZED"
      kind = "obligation"
      text =
        text(
          "生成 backend の失敗は source map 経由で仕様要素へ正規化される",
          "Generated backend failures are normalized back to source spec elements through source maps",
        )
      terms {
        "artifact.counterexample_normalizer"
        "artifact.source_map"
        "artifact.formal_backend"
        "concept.rule"
      }
      must {
        new d.Clause {
          expr =
            "normalizeCounterexamples(report, source-map).returns(ruleId, sourcePath, localizedText)"
          ast = new d.ExprAst {
            op = "atom"
            name = "normalizesCounterexample"
            args {
              "report"
              "source-map"
            }
          }
          text =
            text(
              "正規化結果は backend、generated selector、source path、Rule.id、人間向け説明を含む",
              "the normalized result contains backend, generated selector, source path, Rule.id, and a human-facing message",
            )
        }
        d.clause(
          "normalizeCounterexamples(tlaOrAlloyWitness).uses(source-map.generatedSelector)",
          "TLA+/Alloy の失敗 message が生成 selector を含む場合は source map で仕様要素へ戻す",
          "when TLA+/Alloy failure messages contain generated selectors, source maps normalize them back to spec elements",
