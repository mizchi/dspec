          }
        }
        d.nodeCheck("test/cli.test.mjs#detects and refreshes stale assurance evidence manifests")
        d.nodeCheck("test/cli.test.mjs#rejects formal assurance when backend binding is structural only")
        d.nodeCheck("test/cli.test.mjs#rejects legacy references as formal assurance evidence")
      }
      implementedBy {
