    new d.Rule {
      id = "DSPEC-LEAN-EQ-SEMANTIC"
      kind = "invariant"
      text =
        text(
          "Lean は等価性 fragment の Clause を満足関係と clause 定理として検証する",
          "Lean verifies equality-fragment Clauses through a satisfaction relation and clause theorem",
        )
      terms {
        "artifact.assurance_evidence_manifest"
        "artifact.formal_backend"
        "artifact.source_map"
        "concept.clause_backend_support"
        "concept.expr_ast"
        "concept.rule"
        "concept.verification_target"
      }
      must {
        d.clause(
          "ClauseEnv == String -> Option String",
          "Lean の ClauseEnv は未束縛名を区別できる部分環境として扱う",
          "Lean ClauseEnv is a partial environment that preserves unbound names",
        )
        d.clause(
          "Satisfies(env, eq(left, right)) == (resolve(env, left) == resolve(env, right))",
          "Satisfies は eq の左右を ClauseEnv で解決して等価性を判定する",
          "Satisfies resolves both eq operands through ClauseEnv and compares them",
        )
        d.clause(
          "Satisfies(env, neq(left, right)) == (resolve(env, left) != resolve(env, right))",
          "Satisfies は neq の左右を ClauseEnv で解決して不等価性を判定する",
          "Satisfies resolves both neq operands through ClauseEnv and compares them for inequality",
        )
        d.clause(
          "Satisfies(env, not(child)) == not(Satisfies(env, child))",
          "Satisfies は not を子 Clause の命題否定として解釈する",
          "Satisfies interprets not as proposition negation of the child Clause",
        )
        d.clause(
          "Satisfies(env, implies(left, right)) == (Satisfies(env, left) -> Satisfies(env, right))",
          "Satisfies は implies を左右の Clause 命題間の含意として解釈する",
          "Satisfies interprets implies as implication between the left and right Clause propositions",
        )
        d.clause(
          "semantic(lean, clause) iff operators(clause) subsetOf {eq, neq, not, implies}",
          "Lean は eq/neq/not/implies のみで構成された Clause を semantic と分類する",
          "Lean classifies a Clause as semantic only when it is composed of eq, neq, not, and implies",
        )
        d.clause(
          "proved(lean, selector) -> generatedClauseTheorem(selector)",
          "Lean proved target は対象 Clause ごとの定理を決定的に生成する",
          "a Lean proved target deterministically generates a theorem for each selected Clause",
        )
        d.clause(
          "clauseTheorem.failed -> evidence.create.failed",
          "Clause 定理を証明できない場合は evidence manifest を生成しない",
          "evidence manifest creation fails when the Clause theorem cannot be proved",
        )
        d.clause(
          "clauseArtifact.propertyIds intersects clauseBinding.generatedSelectors",
          "clause-scoped artifact は source map の Clause selector と同じ theorem を束縛する",
          "the clause-scoped artifact binds the same theorem as the source-mapped Clause selector",
        )
      }
      reviewStatus = "approved"
      requiredAssurances {
        "executed"
      }
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#proves Lean eq clauses with clause-scoped evidence"
          assurances {
            "executed"
          }
          assuranceEvidence {
            ["executed"] = "Taskfile.pkl#test"
          }
        }
        d.nodeCheck("test/cli.test.mjs#keeps Lean eq semantic proofs load-bearing")
        d.nodeCheck("test/cli.test.mjs#proves composed Lean implication clauses with clause-scoped evidence")
        d.nodeCheck("test/cli.test.mjs#keeps composed Lean implication proofs load-bearing")
        d.nodeCheck("test/assurance-evidence-core.test.mjs#classifies the supported Lean equality fragment as semantic")
      }
      implementedBy {
        d.codeRef("src/core/assurance-evidence.mjs", "CLAUSE_BACKEND_OPERATOR_SUPPORT")
        d.codeRef("src/cli.mjs", "leanSemanticClauseProofs")
        d.codeRef("src/cli.mjs", "emitLeanClauseTheorem")
        d.codeRef("src/cli.mjs", "emitLean")
        d.codeRef("src/cli.mjs", "assuranceEvidenceArtifactDefinitions")
        d.modelRef("fixtures/assurance-formal-lean-eq.pkl")
        d.modelRef("fixtures/assurance-formal-lean-eq-broken.pkl")
        d.modelRef("fixtures/assurance-formal-lean-implies.pkl")
        d.modelRef("fixtures/assurance-formal-lean-implies-broken.pkl")
      }
    }

    new d.Rule {
      id = "DSPEC-PRODUCT-POSITIONING"
      kind = "invariant"
      text =
        text(
          "dspec は双方向ドリフト検出を中心とする仕様・保証ツールキットであり、汎用定理証明器ではない",
          "dspec is a system specification and assurance toolkit centered on bidirectional drift detection, not a general theorem prover",
        )
      terms {
        "artifact.assurance_evidence_manifest"
        "artifact.domain_coverage_oracle"
        "artifact.formal_backend"
        "artifact.real_app_importer"
        "artifact.reconciliation_oracle"
        "artifact.reverse_coverage_oracle"
        "concept.clause_backend_support"
      }
      must {
        d.clause(
          "primaryValue == reconcile(authoredModel, observedFacts) + reverseCoverage + domainCoverage",
          "中心の価値は、著者モデル・観測事実・承認 rule の双方向照合にある",
          "the primary value is bidirectional reconciliation among the authored model, observed facts, and approved rules",
        )
        d.clause(
          "executableSpecification == deterministic(check + projection + reconciliation + evidence)",
          "実行可能とは決定的な検査・生成・照合・証跡であり、任意の実装を自動証明する意味ではない",
          "executable means deterministic checks, projections, reconciliation, and evidence, not automatic proof of arbitrary implementations",
        )
        d.clause(
          "proved(selector) -> semanticBackendSupport(selector) && scope(selector) == selectedClause",
          "proved は semantic backend 対応と選択された Clause の範囲に限定する",
          "proved is limited to semantic backend support and the selected Clause scope",
        )
        d.clause(
          "importerPass != deploymentOrProductionReachabilityProof",
          "importer の成功は deployment や production 到達性の証明ではない",
          "an importer pass is not deployment or production-reachability proof",
        )
        d.clause(
          "importerCoverage == declaredAdapters",
          "現在の対応スタックは adapter の対応範囲であり、言語本体の恒久的な境界ではない",
          "the currently supported stack is adapter coverage, not a permanent boundary of the language",
        )
      }
      reviewStatus = "approved"
      requiredAssurances {
        "executed"
      }
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#keeps product positioning and assurance boundaries explicit"
          assurances {
            "executed"
          }
          assuranceEvidence {
            ["executed"] = "Taskfile.pkl#test"
          }
        }
      }
    }

    new d.Rule {
      id = "DSPEC-FORMAL-SOURCE-OF-TRUTH"
      kind = "invariant"
      text =
        text(
          "規範的な仕様は形式モデルに置き、自然言語・テスト oracle・実装適合はそこから導出する",
          "Normative specifications live in a formal model, from which natural language, test oracles, and implementation conformance derive",
        )
      terms {
        "artifact.formal_backend"
        "artifact.implementation_conformance"
        "artifact.markdown"
        "artifact.quickcheck"
        "concept.localized_text"
        "concept.expr_ast"
        "concept.localized_text"
      }
      must {
        d.clause(
          "normativeMeaning == formalModel; localizedText == projection(formalModel)",
          "規範的意味は形式モデルにあり、locale 文言はそこからの review 投影である",
          "Normative meaning belongs to the formal model, while locale text is its review projection",
        )
        d.clause(
          "formalModel -> derive(markdown + quickcheck + formalBackend); implementation -> passes(declaredOracle)",
          "Markdown・テスト oracle・形式 backend は同じ形式モデルから決定的に生成し、実装は宣言済み oracle を通過する",
          "Markdown, test oracles, and formal backends derive deterministically from one formal model, and implementations pass declared oracles",
        )
        d.clause(
          "llm(changeRequest|question) -> candidate(formalModelEdit|structuredQuery) -> validate + review + evidence",
          "LLM の変更案や問い合わせ解釈は形式モデル編集または構造化 query の候補であり、検証・review・証跡を通るまで規範ではない",
          "An LLM change proposal or question interpretation is a candidate formal-model edit or structured query, not normative until validation, review, and evidence pass",
        )
        d.clause(
          "formalSource.elements == {goal.formal-source-of-truth, claim.formal-source-of-truth, assurance.formal-source-of-truth-property, assurance.formal-source-of-truth-lean, binding.formal-source-of-truth}",
          "自己仕様の formal source Goal graph 要素は stable ID でこの rule に接地する",
          "The self-spec formal-source Goal graph elements are grounded in this rule by stable id",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#keeps product positioning and assurance boundaries explicit")
      }
      rationale =
        "Pkl は現在の型付き IR であり、Lean の意味論的証明は対応 fragment に限定される。形式 first は宣言で完了せず、対応範囲ごとの formal artifact と実装 oracle を段階的に増やす。"
    }

    new d.Rule {
      id = "DSPEC-DAILY-DRIFT-REVIEW"
      kind = "obligation"
      text =
        text(
          "日次 batch は Intent・形式・実装の決定的 drift packet を作り、LLM は read-only review と候補提案だけを行う",
          "The daily batch builds a deterministic Intent/formal/implementation drift packet, while the LLM performs read-only review and candidate proposals only",
        )
      terms {
        "artifact.daily_drift_packet"
        "artifact.daily_drift_manifest"
        "artifact.daily_drift_baseline"
        "artifact.drift_review_skill"
        "artifact.drift_review_evaluation"
        "artifact.daily_drift_workflow"
        "artifact.formal_backend"
        "artifact.implementation_conformance"
        "artifact.quickcheck"
      }
      must {
        d.clause(
          "dailyDriftPacket.targets == manifest.targets; applicationTarget -> observed(appProfile|intentBindings|intentExercise); runtimeTarget -> observed(runtimeEvidence)",
          "日次 packet は型付き target manifest の全対象を巡回し、application target では AppProfile または明示した実装観測を、runtime target では runtime evidence を保存する",
          "The daily packet visits every typed manifest target, retains AppProfile or declared implementation observations for every application target, and retains runtime evidence for every runtime target",
        )
        d.clause(
          "dailyLlmReview == readOnly(packet) -> candidate(change|query); candidate != authoritativeChange",
          "LLM review は packet の read-only 観測と変更または query 候補の提案に限定し、候補自体は規範的変更ではない",
          "The LLM review is limited to read-only packet observation and change or query candidates; a candidate is not an authoritative change",
        )
        d.clause(
          "dailyDriftPacket.reviewProjection == render(target.locales)",
          "packet は target が宣言した各 locale の Markdown 投影を保存し、LLM review は人間可読な意味差を根拠付きで比較できる",
          "The packet retains a Markdown projection for every target locale so LLM review can compare human-readable meaning differences with evidence",
        )
        d.clause(
          "dailyDriftBaseline == explicitApproval(targetModel + intentGraph + specChangeReview); targetChange -> review",
          "target model または Intent graph の変更は、対象 model digest に一致する spec-change review と承認者・承認 ID を持つ baseline を明示更新するまで日次 drift として扱う",
          "A target model or Intent graph change remains daily drift until an explicitly approved baseline binds a matching spec-change review, approver, and approval id",
        )
        d.clause(
          "dailyLlmReview.evaluation == seeded(intentFormal + implementation + i18n + noDrift)",
          "LLM review は Intent/formal/implementation/i18n と no-drift の seed 評価で根拠・分類・過検知を回帰検査する",
          "LLM review regression-tests evidence, classification, and restraint with seeded Intent/formal/implementation/i18n and no-drift cases",
        )
        d.clause(
          "dailyDriftWorkflow.schedule == cron && packetArtifact == retained && llmJob == packetOnly",
          "daily workflow は cron で実行し、packet を artifact として保持する。LLM job は repository checkout なしで packet のみを読む",
          "The daily workflow runs on cron, retains the packet as an artifact, and gives the LLM job packet-only access without a repository checkout",
        )
        d.clause(
          "dailyDrift.elements == {goal.daily-drift-review, claim.daily-drift-review, assurance.daily-drift-review-property}",
          "日次 drift review の Goal graph 要素は stable ID でこの rule に接地する",
          "The daily drift-review Goal graph elements are grounded in this rule by stable id",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/daily-drift-packet.test.mjs#exposes daily packet collection and approved baselines through dspec")
        d.nodeCheck("test/daily-drift-packet.test.mjs#requires an explicit approval to establish and then enforce a target baseline")
        d.nodeCheck("test/daily-drift-packet.test.mjs#writes typed target reports and declared implementation observations")
        d.nodeCheck("test/daily-drift-packet.test.mjs#retains every report when a target's deterministic drift checks fail")
        d.nodeCheck("test/daily-drift-packet.test.mjs#runs an application target's implementation observation gate")
        d.nodeCheck("test/daily-drift-packet.test.mjs#runs declared runtime evidence as a target observation gate")
        d.nodeCheck("test/daily-drift-packet.test.mjs#keeps the daily LLM drift review read-only and artifact-only")
        d.nodeCheck("test/daily-drift-review-eval.test.mjs#scores required drift findings, evidence paths, and no-drift restraint")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "runDailyDrift")
        d.codeRef("scripts/generate-daily-drift-packet.mjs", "main")
        d.codeRef("scripts/generate-daily-drift-packet.mjs", "evaluateSpecChangeReviews")
        d.codeRef("scripts/generate-daily-drift-packet.mjs", "reviewPrompt")
        d.codeRef("scripts/evaluate-daily-drift-review.mjs", "main")
        d.codeRef("scripts/evaluate-daily-drift-review.mjs", "scoreCase")
        d.modelRef("dspec/DailyDrift.pkl")
        d.modelRef("examples/daily-drift-targets.pkl")
        d.modelRef("examples/daily-drift-baseline.json")
        d.modelRef("fixtures/daily-drift-review-eval-suite.json")
        d.runtimeRef(".github/workflows/daily-drift-review.yml")
        d.runtimeRef("skills/dspec-intent-formal-implementation-drift/SKILL.md")
      }
      rationale =
        "定期巡回の入力を型付き target、承認 baseline、決定的な証跡 packet に限定すると、LLM の評価は再現可能な事実と候補の分類に集中できる。AppProfile 等の観測を宣言しない tooling-self target は任意実装の意味論的等価性を保証せず、自動是正もしない。"
    }

    new d.Rule {
      id = "DSPEC-DOMAIN-COVERAGE-ORACLE"
      kind = "invariant"
