        }
      }
    }

    new d.Rule {
      id = "DSPEC-DB-MIGRATION-PATTERN"
      kind = "obligation"
      text =
        text(
          "DB migration は typed pattern として記述され、preserve 宣言を backend に投影する",
          "DB migrations are authored as a typed pattern and project preservation declarations to backends",
        )
      terms {
        "artifact.db_model_pattern"
        "artifact.generator"
        "concept.db_invariant"
        "concept.db_migration"
      }
      must {
        new d.Clause {
          expr = "patterns.db.migrations.touch(table) -> migration.preserves(touchedInvariant)"
          ast = new d.ExprAst {
            op = "atom"
            name = "dbMigrationPreservesInvariant"
            args {
              "migration"
              "invariant"
            }
          }
          text =
            text(
              "DB migration は from/to table に関わる invariant の preserve 宣言を持つ",
              "DB migrations declare preservation for invariants touched by source or target tables",
            )
        }
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#rejects invalid DB migration references"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#emits DB model pattern into backend projections"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#keeps generated DB migration checks load-bearing"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#normalizes DB migration counterexamples to source patterns"
        }
      }
      implementedBy {
        new d.ImplementationRef {
          kind = "model"
          path = "dspec/Schema.pkl"
          symbol = "DbMigration"
        }
        new d.ImplementationRef {
          kind = "model"
          path = "dspec/Schema.pkl"
          symbol = "DbMapping"
        }
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "dbMigrationTouchedInvariantIds"
        }
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "propertyDbMigrationsPreserveInvariants"
