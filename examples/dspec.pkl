    new d.Rule {
      id = "DSPEC-SQL-QUERY-ORACLE"
      kind = "obligation"
      text =
        text(
          "SQL query catalog は DB model と照合され、schema/tenant/FK drift を検出する",
          "SQL query catalogs are checked against the DB model to detect schema, tenant, and FK drift",
        )
      terms {
        "artifact.sql_query_oracle"
        "artifact.db_model_pattern"
      }
      must {
        d.clause(
          "query.tablesAndColumns ⊆ patterns.db.tablesAndColumns",
          "query が参照する table/column は patterns.db に存在する",
          "query table and column references exist in patterns.db",
        )
        d.clause(
          "query.touches(tenantScopedTable) -> query.mentions(tenantColumn)",
          "tenant scoped table を触る query は tenant column を含む",
          "queries touching tenant-scoped tables mention the tenant column",
        )
        d.clause(
          "query.joins(fkTable, targetTable) -> query.mentions(fkColumn, targetKey)",
          "FK 関係の table を join する query は FK column と target key を含む",
          "queries joining FK-related tables mention the FK column and target key",
        )
      }
      reviewStatus = "approved"
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#checks SQL query catalog against DB model"
        }
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#reports SQL query drift as JSON"
