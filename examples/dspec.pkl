    new d.Rule {
      id = "DSPEC-MARKDOWN-REVIEW-ARTIFACT"
      kind = "obligation"
      text =
        text(
          "各 locale の Markdown review artifact は仕様モデルから決定的に再生成できる",
          "The Markdown review artifact for each locale is deterministically regenerated from the spec model",
        )
      terms {
        "artifact.markdown"
        "artifact.generator"
        "artifact.projection"
        "artifact.generation_plan"
        "artifact.projection_provenance"
        "artifact.generation_transaction"
        "artifact.generation_lock"
        "artifact.generation_lease"
      }
      must {
        new d.Clause {
          expr = "projection(self-markdown).artifacts == locales.map(locale -> generated/examples/{locale}/dspec.md)"
          text =
            text(
              "self-markdown projection は各 locale の Markdown を exact freshness で管理する",
              "the self-markdown projection manages Markdown for every locale with exact freshness",
            )
        }
        d.clause(
          "derive(entrypoint.model).projections == []",
          "entrypoint の model を派生しても生成物 ownership は継承しない",
          "deriving an entrypoint model does not inherit generated artifact ownership",
        )
        d.clause(
          "emit(markdown).rules.include(source, coverage, selectors, checks, implementations)",
          "Markdown は各 rule の source、coverage、clause selector、check、implementation を review 情報として含む",
          "Markdown includes source, coverage, clause selectors, checks, and implementations as per-rule review metadata",
        )
        d.clause(
          "emit(markdown).reviewSummary.includes(approvedRules + automatedChecks + implementationRefs + projections + domainElements + runtimeEvidenceRecords)",
          "Markdown は review summary として rule/check/ref/projection/domain/evidence の集計を含む",
          "Markdown includes review-summary counts for rules, checks, refs, projections, domain elements, and evidence records",
        )
        d.clause(
          "plan(projection, observedState) -> {create, update, remove, unchanged} without filesystem mutation",
          "Projection planner は filesystem を変更せず create/update/remove/unchanged と digest を返す",
          "the Projection planner returns create, update, remove, unchanged, and digests without mutating the filesystem",
        )
        d.clause(
          "generate(dryRun).writes == 0 && generate(plan).argv is List<String>",
          "dry-run は書き込まず、再生成コマンドは shell 文字列ではなく argv でも表現する",
          "dry-run performs no writes and regeneration commands are also represented as argv rather than only shell text",
        )
        d.clause(
          "provenance == modelDigest + projectionId + emitterVersion + stableGeneratedAt + artifactDigests",
          "provenance は model/projection/emitter/artifact digest と安定した生成時刻を束縛する",
          "provenance binds model, projection, emitter, artifact digests, and a stable generation time",
        )
        d.clause(
          "transaction.failure -> rollback(allCommittedPaths)",
          "staging 後の commit が失敗した場合は更新済み path をすべて rollback する",
          "a commit failure after staging rolls back every already committed path",
        )
        d.clause(
          "concurrent(generate(root), generate(root)) -> atMostOneCommitter && failure.releases(lock(root))",
          "同一 root の生成 transaction は排他され、失敗後も lock を解放する",
          "generation transactions for the same root are mutually exclusive and release the lock after failure",
        )
        d.clause(
          "lockOwner == {pid, hostname, acquiredAt, heartbeatAt, leaseMs, token}",
          "lock は所有者情報と期限付きheartbeatを記録する",
          "locks record ownership and a leased heartbeat",
        )
        d.clause(
          "unlock(lock) requires dead(owner) || expired(lease) || force",
          "通常回復は停止済みownerまたは期限切れleaseだけを解除する",
          "normal recovery removes only dead owners or expired leases",
        )
        d.clause(
          "transaction(stage|commit) -> renew(lock.lease)",
          "transaction は staging と commit の進行中にleaseを更新する",
          "transactions renew the lease while staging and committing",
        )
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#checks dspec's localized projection artifacts")
        d.nodeCheck("test/cli.test.mjs#checks sample webapp localized projection artifacts")
        d.nodeCheck("test/cli.test.mjs#does not inherit entrypoint projection ownership through model amendments")
        d.nodeCheck("test/cli.test.mjs#generates and checks localized projection artifacts")
        d.nodeCheck("test/cli.test.mjs#keeps generate projection JSON report fixture in sync")
        d.nodeCheck("test/cli.test.mjs#keeps generated check projection JSON report fixture in sync")
        d.nodeCheck("test/cli.test.mjs#rejects projection locale matrices without a locale output placeholder")
        d.nodeCheck("test/cli.test.mjs#previews Projection generation without writing")
        d.nodeCheck("test/cli.test.mjs#rejects invalid Projection generation timestamps as command errors")
        d.nodeCheck("test/cli.test.mjs#writes and checks Projection provenance without changing its stable generation time")
        d.nodeCheck("test/cli.test.mjs#dogfoods single-locale and monorepo Projection holdouts")
        d.nodeCheck("test/projection-core.test.mjs#builds deterministic Projection snapshots and provenance")
        d.nodeCheck("test/projection-core.test.mjs#isolates Projection snapshots from renderer mutation")
        d.nodeCheck("test/projection-core.test.mjs#plans create, update, remove, and unchanged actions without filesystem access")
        d.nodeCheck("test/projection-core.test.mjs#preserves provenance generation time while its deterministic inputs stay current")
        d.nodeCheck("test/projection-core.test.mjs#represents generation commands as argv")
        d.nodeCheck("test/projection-core.test.mjs#rejects unsafe or colliding provenance contracts")
        d.nodeCheck("test/projection-transaction.test.mjs#commits a staged Projection transaction")
        d.nodeCheck("test/projection-transaction.test.mjs#rolls back every committed path when a Projection transaction fails")
        d.nodeCheck("test/projection-transaction.test.mjs#serializes Projection transactions and releases the lock after failure")
        d.nodeCheck("test/projection-transaction.test.mjs#records Projection lock ownership and recovers only stale owners")
        d.nodeCheck("test/projection-transaction.test.mjs#protects active foreign Projection leases and recovers expired leases")
        d.nodeCheck("test/projection-transaction.test.mjs#renews Projection leases while staging and committing")
        d.nodeCheck("test/cli.test.mjs#recovers stale Projection generation locks without overriding live owners")
        d.nodeCheck("test/cli.test.mjs#emits deterministic markdown")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "loadModel")
        d.codeRef("src/cli.mjs", "markdownReviewSummary")
        d.codeRef("src/cli.mjs", "generateProjectionArtifacts")
