import "intent-contract.pkl" as base
import "../dspec/Schema.pkl" as d

model: d.Model = (base.model) {
  patterns = new d.PatternCatalog {
    intent = (base.model.patterns.intent) {
      processes = new {
        (base.model.patterns.intent.processes[0]) {
          refinements = new {
            (base.model.patterns.intent.processes[0].refinements[0]) {
              kind = "grpc-method"
              grpc = new d.IntentGrpcEndpoint {
                method = "/approval.v1.RequestService/Approve"
                expectedCode = "OK"
              }
            }
          }
        }
      }
      tests = new {
        new d.IntentProtocolTest {
          id = "approve-grpc-success"
          process = "request.approve"
          refinement = "request.approve-handler"
          outcome = "request.approved"
          input {
            ["requestId"] = "request-002"
            ["amountCents"] = "500"
            ["locale"] = "ja"
            ["notify"] = "true"
          }
          output {
            ["approvalId"] = "approval-request-002"
            ["notified"] = "true"
          }
          expectedGrpcCode = "OK"
        }
      }
    }
  }
}
