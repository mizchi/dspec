import "../dspec/Schema.pkl" as d

model: d.Model = new {
  id = "impact-fixture"
  name = d.text("Impact fixture", "Impact fixture")
  version = "0.1.1"
  primaryLocale = "ja"
  locales {
    "ja"
    "en"
  }

  vocabulary {
    d.term("actor.user", "actor", "ユーザー", "User")
    d.term("action.view", "action", "画面閲覧", "Screen view")
  }

  rules {
    new d.Rule {
      id = "IMPACT-ALLOW"
      kind = "permission"
      text = d.text("ユーザーは表示できる", "Users may view")
      terms {
        "actor.user"
        "action.view"
      }
      must {
        d.clause("allow(actor.user, action.view)", "ユーザーに閲覧を許可する", "Users are allowed to view")
      }
      reviewStatus = "approved"
      implementedBy {
        d.codeRef("src/cli.mjs", "validate")
      }
    }
    new d.Rule {
      id = "IMPACT-AUDIT"
      kind = "obligation"
      text = d.text("閲覧は監査される", "View actions are audited")
      terms {
        "actor.user"
        "action.view"
      }
      must {
        d.clause("audit(action.view)", "閲覧を監査する", "View actions are audited")
      }
      reviewStatus = "approved"
      implementedBy {
        d.codeRef("src/cli.mjs", "validateCoverage")
      }
    }
  }
}
