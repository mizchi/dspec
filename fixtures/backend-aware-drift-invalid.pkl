        d.linkedCheck("alloy", "fixtures/backend-drift/model.als#MissingInvariant")
        d.linkedCheck("runtime", "fixtures/backend-drift/runtime-manifest.json#missing-runtime")
        d.linkedCheck(
          "playwright",
          "fixtures/backend-drift/example.spec.ts#missing playwright target",
        )
      }
    }
  }
}
