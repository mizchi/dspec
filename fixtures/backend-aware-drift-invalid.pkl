  name = d.text("backend-aware drift invalid", "backend-aware drift invalid")
  version = "0.1.0"
  primaryLocale = "en"
  locales {
    "en"
    "ja"
  }
  vocabulary {
    d.term("artifact.backend_check", "entity", "backend check", "backend check")
  }
  rules {
    new d.Rule {
      id = "BACKEND-DRIFT-MISSING"
      kind = "obligation"
      text = d.text("backend check targets resolve", "backend check targets resolve")
      terms {
        "artifact.backend_check"
      }
      must {
        d.clause("backend.targets.resolve", "backend targets resolve", "backend targets resolve")
      }
      reviewStatus = "approved"
      checks {
        d.linkedCheck("lean", "fixtures/backend-drift/Proof.lean#missing_anchor")
