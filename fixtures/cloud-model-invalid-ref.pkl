import "../dspec/Schema.pkl" as d
import "cloud-model.pkl" as base

model: d.Model = (base.model) {
  patterns = new d.PatternCatalog {
    cloud = (base.model.patterns.cloud) {
      nodes {
        new d.CloudNode {
          id = "orphan"
          kind = "service"
          zone = "missing-zone"
        }
      }
    }
  }
}
