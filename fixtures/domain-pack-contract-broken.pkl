  version = "0.1.0"
  primaryLocale = "ja"
  locales {
    "ja"
    "en"
  }

  domainPacks {
    new d.DomainPack {
      id = "bad"
      path = "dspec/domains/Rbac.pkl"
      helpers {
        new d.DomainPackHelper {
          id = "bad.ruleHelper"
          symbol = "onlyRoleCan"
          returns = "rule"
        }
      }
    }
  }
}
