import "../dspec/Schema.pkl" as d
import "../examples/dspec.pkl" as base

model: d.Model = (base.model) {
  rules = new {
    new d.Rule {
      id = "DRIFT-MISSING-SYMBOL"
      kind = "invariant"
      text = base.model.name
      reviewStatus = "approved"
      implementedBy {
        new d.ImplementationRef {
          kind = "code"
          path = "src/cli.mjs"
          symbol = "definitelyMissingSymbol"
        }
      }
      checks {
        new d.CheckTarget {
          backend = "node"
          ref = "test/cli.test.mjs#detects missing implementation symbols"
        }
      }
    }
  }
}
