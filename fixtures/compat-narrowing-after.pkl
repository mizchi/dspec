import "../dspec/Schema.pkl" as d

model: d.Model = new {
  id = "compat-fixture"
  name = d.text("Compatibility fixture", "Compatibility fixture")
  version = "0.2.0"
  primaryLocale = "ja"
  locales {
    "ja"
    "en"
  }

  vocabulary {
    d.term("actor.user", "actor", "ユーザー", "User")
    d.term("action.view", "action", "閲覧", "View")
  }

  rules {
    new d.Rule {
      id = "COMPAT-ALLOW-VIEW"
      kind = "permission"
      text = d.text("ユーザーは閲覧できる", "Users may view")
      terms {
        "actor.user"
        "action.view"
      }
      must {
        d.clause("allow(actor.user, action.view)", "ユーザーに閲覧を許可する", "Users are allowed to view")
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#classifies spec compatibility changes")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "validate")
      }
    }
    new d.Rule {
      id = "COMPAT-AUDIT-VIEW"
      kind = "obligation"
      text = d.text("閲覧は監査される", "Views are audited")
      terms {
        "actor.user"
        "action.view"
      }
      must {
        d.clause("audit(action.view)", "閲覧操作を監査する", "View actions are audited")
      }
      reviewStatus = "approved"
      checks {
        d.nodeCheck("test/cli.test.mjs#classifies spec compatibility changes")
      }
      implementedBy {
        d.codeRef("src/cli.mjs", "validate")
      }
    }
  }
}
