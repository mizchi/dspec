model: d.Model = (base.model) {
  id = "db-model-migration-missing-preserve"
  patterns = new d.PatternCatalog {
    db = (base.model.patterns.db) {
      migrations {
        new d.DbMigration {
          id = "v2-add-payments-without-preserve"
          text = base.model.name
          fromTables {
            "orders"
          }
          toTables {
            "orders"
            "payments"
          }
        }
      }
    }
  }
}
