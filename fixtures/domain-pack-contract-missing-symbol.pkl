import "../dspec/Schema.pkl" as d

model: d.Model = new {
  id = "domain-pack-contract-missing-symbol"
  name =
    d.text(
      "Domain pack contract missing symbol fixture",
      "Domain pack contract missing symbol fixture",
    )
  version = "0.1.0"
  primaryLocale = "ja"
  locales {
    "ja"
    "en"
  }

  domainPacks {
    new d.DomainPack {
      id = "rbac"
      path = "dspec/domains/Rbac.pkl"
      helpers {
        new d.DomainPackHelper {
          id = "rbac.missing"
          symbol = "missingHelper"
          returns = "term"
        }
      }
    }
  }
}
