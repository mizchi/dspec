    "DSPEC-SPEC-COMPAT-CLASSIFIER" -> List("utf8:Y29tcGF0aWJpbGl0eSByZXBvcnQg44Gv5YWo5L2T5YiG6aGe44KSIHN0YWJsZSBlbnVtIOOBqOOBl-OBpui_lOOBmQ", "utf8:5ZCE5aSJ5pu044Gv5YiG6aGe44Go55CG55Sx44KSIGRlY2lzaW9uIOOBqOOBl-OBpuiqrOaYjuOBmeOCiw", "utf8:5om_6KqN5riI44G_IHJ1bGUg5YmK6Zmk44GvIGJyZWFraW5n44CBb2JsaWdhdGlvbiDov73liqDjga8gbmFycm93aW5n44CBcGVybWlzc2lvbiDov73liqDjga8gd2lkZW5pbmcg44Go44GX44Gm5omx44GG"),
    "DSPEC-SPEC-DIFF-IMPACT" -> List("utf8:aW1wYWN0IOOBryB0ZXJtL3J1bGUg44GuIGFkZGVkL3JlbW92ZWQvbW9kaWZpZWQg44KS5qSc5Ye644GZ44KL", "utf8:5aSJ5pu044GV44KM44GfIHRlcm0g44Gv5Y-C54WnIHJ1bGXjgIHnlJ_miJAgc2VsZWN0b3LjgIFpbXBsZW1lbnRhdGlvbiByZWZzIOOBq-WxlemWi-OBleOCjOOCiw", "utf8:aW1wYWN0IOOBryBwcm9qZWN0aW9uIOW3ruWIhuOBqCByZWdlbmVyYXRlL3JlbW92ZSDlr77osaEgYXJ0aWZhY3TjgIHjgYrjgojjgbPlho3nlJ_miJDjgrPjg57jg7Pjg4njgpLov5TjgZk"),
