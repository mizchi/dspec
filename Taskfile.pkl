    "node src/cli.mjs coverage-spec-reading-eval-suite --json fixtures/spec-reading-eval-suite.pkl | diff -u fixtures/reports/coverage-spec-reading-eval-suite.json - && node src/cli.mjs metamorphic-spec-reading-eval --json fixtures/spec-reading-eval-sample-webapp.pkl | diff -u fixtures/reports/metamorphic-spec-reading-eval.json -"
  inputs = new {
    ...pklSources
    ...jsonFixtures
    ...jsSources
