local behaviorVerify: Task = new {
  name = "behavior:verify"
  description = "Check generated Lean, the behavior DSL reference model, and its implementation adapter"
  cmd = "node scripts/generate-behavior-transition.mjs --check fixtures/behavior-purchase.pkl fixtures/behavior/CommercePurchaseGenerated.lean && lean fixtures/behavior/CommercePurchaseGenerated.lean && node scripts/verify-behavior.mjs fixtures/behavior-purchase.pkl"
  inputs = new {
    ...pklSources
    ...jsSources
    ...leanSources
  }
}

local behaviorGenerate: Task = new {
  name = "behavior:generate"
  description = "Render the behavior DSL fixture as a deterministic Lean transition model"
  cmd = "node scripts/generate-behavior-transition.mjs fixtures/behavior-purchase.pkl fixtures/behavior/CommercePurchaseGenerated.lean"
  inputs = new {
    ...pklSources
    ...jsSources
  }
  outputs = new {
    "fixtures/behavior/CommercePurchaseGenerated.lean"
  }
}

