amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.11.0#/Taskfile.pkl"

local pklSources: Listing<String> = new {
  "PklProject"
  "Taskfile.pkl"
  "dspec/**/*.pkl"
  "examples/**/*.pkl"
  "fixtures/**/*.pkl"
  "pkl-tests/**/*.pkl"
}

local jsonFixtures: Listing<String> = new {
  "fixtures/**/*.json"
}

local traceLocks: Listing<String> = new {
  "examples/**/*.trace.lock.json"
}

local translationLocks: Listing<String> = new {
  "examples/**/*.translation.lock.json"
}

local markdownFixtures: Listing<String> = new {
  "fixtures/**/*.md"
}

local sqlFixtures: Listing<String> = new {
  "fixtures/**/*.sql"
}

local realAppFixtures: Listing<String> = new {
  "fixtures/sample-webapp-2026/**/*"
  "fixtures/holdout-*/**/*"
}

local jsSources: Listing<String> = new {
  "package.json"
  "fixtures/agents/**/*.mjs"
  "scripts/**/*.mjs"
  "src/**/*.mjs"
  "test/**/*.mjs"
}

local tsSources: Listing<String> = new {
  "tsconfig.json"
  "tsconfig.build.json"
  "src/**/*.mts"
  "test/**/*.ts"
}

/// Lean fixtures are executed by the Node semantic-core tests. They must take
/// part in the test task action key so a changed theorem cannot be hidden by a
/// cached JavaScript test result.
local leanSources: Listing<String> = new {
  "fixtures/**/*.lean"
}

local reviewArtifacts: Listing<String> = new {
  "generated/backends/**/*"
  "generated/examples/**/*.md"
  "generated/holdouts/**/*.md"
  "generated/**/*.provenance.json"
  "generated/source-map.json"
  "generated/manifest.json"
}

local nixSources: Listing<String> = new {
  "flake.nix"
  "flake.lock"
  ".envrc"
}

local ciSources: Listing<String> = new {
  ".github/workflows/*.yml"
}

local projectMetadata: Listing<String> = new {
  "README.md"
  "LICENSE"
  "pnpm-lock.yaml"
  ".release-please-manifest.json"
  "release-please-config.json"
  "docs/**/*.md"
}

local schema: Task = new {
  name = "schema"
  description = "Evaluate Pkl schema examples"
  cmd = "pkl eval examples/*.pkl fixtures/*.pkl >/dev/null"
  inputs = pklSources
}

local test: Task = new {
  name = "test"
  description = "Run Node unit tests"
  cmd = "node --test"
  inputs = new {
    ...pklSources
    ...jsonFixtures
    ...markdownFixtures
    ...sqlFixtures
    ...realAppFixtures
    ...jsSources
    ...tsSources
    ...leanSources
    ...reviewArtifacts
    ...nixSources
    ...ciSources
    ...projectMetadata
  }
  deps { schema; typecheck; build }
}

local typecheck: Task = new {
  name = "typecheck"
  description = "Type-check TypeScript semantic and CLI command boundaries"
  cmd = "pnpm run typecheck"
  inputs = new {
    "package.json"
    "pnpm-lock.yaml"
    ...tsSources
  }
}

local build: Task = new {
  name = "build"
  description = "Compile TypeScript semantic and CLI command sources to executable Node modules"
  cmd = "pnpm run build"
  inputs = new {
    "package.json"
    "pnpm-lock.yaml"
    ...tsSources
  }
}

local packageReview: Task = new {
  name = "package:review"
  description = "Check the public npm package contents"
  cmd = "npm pack --dry-run --json >/dev/null"
  inputs = new {
    ...pklSources
    ...jsSources
    ...tsSources
    ...projectMetadata
  }
  deps { build }
}

local packageSmoke: Task = new {
  name = "package:smoke"
  description = "Install the packed public package into a clean consumer"
  cmd = "pnpm run package:smoke"
  inputs = new {
    ...pklSources
    ...jsSources
    ...tsSources
    ...projectMetadata
  }
  deps { typecheck; build }
}

local checkerConformance: Task = new {
  name = "checker:conformance"
  description = "Verify the portable checker report conformance suite"
  cmd = "pnpm run checker:conformance"
  inputs = new {
    ...pklSources
    ...jsonFixtures
    ...realAppFixtures
    ...jsSources
    ...tsSources
    ...projectMetadata
  }
  deps { schema; build }
}

local meandbTraceability: Task = new {
  name = "meandb:traceability"
  description = "Build the self specification's meandb projection and query explained implementation traceability (set DSPEC_MEANDB when meandb is not on PATH)"
  cmd = "pnpm run meandb:traceability"
  inputs = new {
    ...pklSources
    ...jsSources
    "examples/**/*.gql"
  }
  deps { build }
  cache = false
}

local drift: Task = new {
  name = "drift"
  description = "Check implementation and test references in the self model"
  cmd = "node src/cli.mjs drift examples/dspec.pkl"
  inputs = new {
    ...pklSources
    ...sqlFixtures
    ...jsSources
    ...reviewArtifacts
    ...nixSources
    ...ciSources
    ...projectMetadata
  }
  deps { schema; build }
}

local coverage: Task = new {
  name = "coverage"
  description = "Check approved-rule coverage in the self model"
  cmd = "node src/cli.mjs coverage examples/dspec.pkl"
  inputs = new {
    ...pklSources
    ...jsSources
    ...nixSources
    ...ciSources
  }
  deps { drift }
}

local traceVerify: Task = new {
  name = "trace:verify"
  description = "Gate reviewed spec-to-code/test trace locks for the self model"
  cmd = "node src/cli.mjs trace check --gate examples/dspec.pkl"
  inputs = new {
    ...pklSources
    ...traceLocks
    ...jsSources
    ...reviewArtifacts
  }
  deps { schema; build }
}

local translationVerify: Task = new {
  name = "translation:verify"
  description = "Gate reviewed source-to-translation bindings for the self model"
  cmd = "node src/cli.mjs translation check --gate examples/dspec.pkl"
  inputs = new {
    ...pklSources
    ...translationLocks
    ...jsSources
  }
  deps { schema; build }
}

local domainCoverage: Task = new {
  name = "domain-coverage"
  description = "Check domain model element coverage in the real app dogfood model"
  cmd = "node src/cli.mjs domain-coverage examples/sample-webapp-2026.pkl"
  inputs = new {
    ...pklSources
    ...jsSources
  }
  deps { coverage }
}

local realAppReconcile: Task = new {
  name = "real-app:reconcile"
  description =
    "Import, reconcile, reverse-cover, scaffold, evaluate, and profile-check the real app dogfood model"
  cmd =
    "node src/cli.mjs import-real-app --json fixtures/sample-webapp-2026 >/dev/null && node src/cli.mjs import-real-app --pkl fixtures/sample-webapp-2026 >/dev/null && node src/cli.mjs reconcile-real-app examples/sample-webapp-2026.pkl fixtures/reports/import-real-app-sample-webapp.json && node src/cli.mjs reverse-coverage examples/sample-webapp-2026.pkl fixtures/reports/import-real-app-sample-webapp.json && node src/cli.mjs scaffold-app-profile --observed-facts fixtures/reports/import-real-app-sample-webapp.json examples/sample-webapp-2026.pkl fixtures/sample-webapp-2026 >/dev/null && node src/cli.mjs scaffold-app-profile --diff fixtures/sample-webapp-profile.pkl --json --observed-facts fixtures/reports/import-real-app-sample-webapp.json examples/sample-webapp-2026.pkl fixtures/sample-webapp-2026 >/dev/null && node src/cli.mjs scaffold-app-profile --apply fixtures/sample-webapp-profile.pkl --json --dry-run --observed-facts fixtures/reports/import-real-app-sample-webapp.json examples/sample-webapp-2026.pkl fixtures/sample-webapp-2026 >/dev/null && node src/cli.mjs evaluate-app-profile fixtures/sample-webapp-profile.pkl && node src/cli.mjs evaluate-app-profile fixtures/sample-webapp-profile-scenarios.pkl && node src/cli.mjs evaluate-app-profile fixtures/sample-webapp-profile-extended-scenarios.pkl && node src/cli.mjs coverage-app-profile-scenarios fixtures/sample-webapp-profile-extended-scenarios.pkl && node src/cli.mjs score-app-profile-mutations fixtures/sample-webapp-profile-extended-scenarios.pkl && node src/cli.mjs evaluate-app-profile --markdown fixtures/sample-webapp-profile-extended-scenarios.pkl >/dev/null && node src/cli.mjs check-app-profile fixtures/sample-webapp-profile.pkl && node src/cli.mjs check-app-profile-suite fixtures/sample-webapp-profile-suite.pkl && node src/cli.mjs evaluate-app-profile-suite fixtures/sample-webapp-profile-suite.pkl"
  inputs = new {
    ...pklSources
    ...jsonFixtures
    ...realAppFixtures
    ...jsSources
  }
  deps { domainCoverage }
  cache = false
}

local appProfileRefresh: Task = new {
  name = "app-profile:refresh"
  description = "Refresh observed facts for the real app profile"
  cmd = "node src/cli.mjs check-app-profile --fix fixtures/sample-webapp-profile.pkl"
  inputs = new {
    ...pklSources
    ...jsonFixtures
    ...realAppFixtures
    ...jsSources
  }
  cache = false
}

local emitSmoke: Task = new {
  name = "emit:smoke"
  description = "Smoke-test deterministic generators"
  cmd =
    "node src/cli.mjs emit markdown --locale ja examples/dspec.pkl >/dev/null && node src/cli.mjs emit quickcheck examples/dspec.pkl >/dev/null && node src/cli.mjs emit alloy examples/dspec.pkl >/dev/null && node src/cli.mjs emit quint examples/dspec.pkl | node scripts/typecheck-quint-stdin.mjs && node src/cli.mjs emit lean examples/dspec.pkl >/dev/null && node src/cli.mjs emit source-map --locale ja examples/dspec.pkl >/dev/null && node src/cli.mjs emit generated-manifest --locale ja examples/dspec.pkl >/dev/null && node src/cli.mjs emit runtime-collector examples/dspec.pkl >/dev/null && node src/cli.mjs emit runtime-collector-fixture examples/dspec.pkl >/dev/null && node src/cli.mjs domain ir fixtures/domain-codegen.pkl >/dev/null && node src/cli.mjs domain relationships --json fixtures/domain-codegen.pkl >/dev/null && node src/cli.mjs intent schema fixtures/intent-contract.pkl >/dev/null && node src/cli.mjs intent verify --json fixtures/intent-contract.pkl fixtures/intent-traces.json >/dev/null && node src/cli.mjs intent exercise --json --output /tmp/dspec-intent-exercise.json fixtures/intent-contract.pkl fixtures/intent-traces.json >/dev/null && node src/cli.mjs intent generate-tests --json fixtures/intent-contract-http.pkl >/dev/null && node src/cli.mjs intent generate-tests --json fixtures/intent-contract-grpc.pkl >/dev/null && node src/cli.mjs intent coverage --json fixtures/intent-contract-effects-transaction.pkl fixtures/intent-traces-effects-complete.json >/dev/null && node src/cli.mjs intent mutation --json fixtures/intent-contract-effects-transaction.pkl fixtures/intent-traces-effects-complete.json >/dev/null && node src/cli.mjs evidence create --intent-report /tmp/dspec-intent-exercise.json fixtures/intent-contract.pkl >/dev/null && node src/cli.mjs import-db-schema --json fixtures/db-schema.sql >/dev/null && node src/cli.mjs check-sql-queries --json fixtures/db-model.pkl fixtures/db-queries.sql >/dev/null && node src/cli.mjs import-real-app --json fixtures/sample-webapp-2026 >/dev/null && node src/cli.mjs import-real-app --pkl fixtures/sample-webapp-2026 >/dev/null"
  inputs = new {
    ...pklSources
    ...sqlFixtures
    ...jsSources
    ...nixSources
  }
  deps { coverage }
}

local markdownGenerate: Task = new {
  name = "markdown:generate"
  description = "Generate declared review and backend projection artifacts for dogfood entrypoints"
  cmd =
    "node src/cli.mjs generate examples/dspec.pkl && node src/cli.mjs generate examples/sample-webapp-2026.pkl && node src/cli.mjs generate fixtures/projection-holdout-single-locale.pkl && node src/cli.mjs generate fixtures/projection-holdout-monorepo.pkl"
  inputs = new {
    ...pklSources
    ...jsSources
  }
  outputs {
    "generated/backends/**/*"
    "generated/examples/**/*.md"
    "generated/holdouts/**/*.md"
    "generated/**/*.provenance.json"
    "generated/source-map.json"
    "generated/manifest.json"
  }
}

local markdownReview: Task = new {
  name = "markdown:review"
  description = "Check declared review and backend projection artifacts for dogfood entrypoints"
  cmd =
    "node src/cli.mjs generated check examples/dspec.pkl && node src/cli.mjs generated check examples/sample-webapp-2026.pkl && node src/cli.mjs generated check fixtures/projection-holdout-single-locale.pkl && node src/cli.mjs generated check fixtures/projection-holdout-monorepo.pkl"
  inputs = new {
    ...pklSources
    ...jsSources
    ...reviewArtifacts
  }
  deps { coverage }
}

local sourceMapReview: Task = new {
  name = "source-map:review"
  description = "Check generated source-map review artifact"
  cmd =
    "node src/cli.mjs emit source-map --locale ja examples/dspec.pkl | diff -u generated/source-map.json -"
  inputs = new {
    ...pklSources
    ...jsSources
    ...reviewArtifacts
  }
  deps { coverage }
}

local generatedManifestReview: Task = new {
  name = "generated-manifest:review"
  description = "Check generated artifact manifest"
  cmd =
    "node src/cli.mjs emit generated-manifest --locale ja examples/dspec.pkl | diff -u generated/manifest.json -"
  inputs = new {
    ...pklSources
    ...jsSources
    ...reviewArtifacts
  }
  deps { coverage }
}

local dailyDriftPacket: Task = new {
  name = "daily-drift:packet"
  description = "Collect intent, formal, and implementation drift reports for an LLM review packet"
  cmd =
    "node src/cli.mjs daily-drift collect --fail-on-drift --require-formal-tools --output .dspec/daily-drift examples/daily-drift-targets.pkl"
  inputs = new {
    ...pklSources
    ...jsSources
    ...reviewArtifacts
  }
  outputs {
    ".dspec/daily-drift/**/*"
  }
  cache = false
}

local dailyDriftEval: Task = new {
  name = "daily-drift:eval"
  description = "Score seeded daily LLM drift-review findings and no-drift restraint"
  cmd =
    "node scripts/evaluate-daily-drift-review.mjs --json fixtures/daily-drift-review-eval-suite.json fixtures/daily-drift-review-eval-answers.json"
  inputs = new {
    ...jsSources
    "fixtures/daily-drift-review-eval-*.json"
  }
}

local reportFixturesReview: Task = new {
  name = "report-fixtures:review"
  description = "Check report compatibility fixtures"
  cmd =
    "node src/cli.mjs check --json examples/dspec.pkl | diff -u fixtures/reports/check-dspec.json - && node src/cli.mjs drift --json examples/dspec.pkl | diff -u fixtures/reports/drift-dspec.json - && node src/cli.mjs coverage --json examples/dspec.pkl | diff -u fixtures/reports/coverage-dspec.json - && node src/cli.mjs conformance --json fixtures/conformance-webapp.pkl | diff -u fixtures/reports/conformance-webapp.json - && node src/cli.mjs query --json --locale ja --answer fixtures/spec-query-answer-valid.json fixtures/conformance-webapp.pkl rule WEBAPP-ACCESS-CONFORMANCE | diff -u fixtures/reports/spec-query-webapp.json - && node src/cli.mjs domain-coverage --json examples/sample-webapp-2026.pkl | diff -u fixtures/reports/domain-coverage-sample-webapp.json - && node src/cli.mjs import-real-app --json fixtures/sample-webapp-2026 | diff -u fixtures/reports/import-real-app-sample-webapp.json - && node src/cli.mjs evaluate-real-app-import --json fixtures/import-real-app-eval-mnemo.pkl | diff -u fixtures/reports/evaluate-real-app-import-mnemo.json - && node src/cli.mjs evaluate-real-app-import --json fixtures/import-real-app-eval-iac.pkl | diff -u fixtures/reports/evaluate-real-app-import-iac.json - && node src/cli.mjs evaluate-external-holdouts --json fixtures/external-holdout-real-app-import.pkl | diff -u fixtures/reports/evaluate-external-holdouts.json - && node src/cli.mjs reconcile-real-app --json examples/sample-webapp-2026.pkl fixtures/reports/import-real-app-sample-webapp.json | diff -u fixtures/reports/reconcile-real-app-sample-webapp.json - && node src/cli.mjs reverse-coverage --json examples/sample-webapp-2026.pkl fixtures/reports/import-real-app-sample-webapp.json | diff -u fixtures/reports/reverse-coverage-sample-webapp.json - && node src/cli.mjs scaffold-app-profile --diff fixtures/sample-webapp-profile.pkl --json --observed-facts fixtures/reports/import-real-app-sample-webapp.json examples/sample-webapp-2026.pkl fixtures/sample-webapp-2026 | diff -u fixtures/reports/scaffold-app-profile-diff.json - && node src/cli.mjs evaluate-app-profile --json fixtures/sample-webapp-profile.pkl | diff -u fixtures/reports/evaluate-app-profile-sample-webapp.json - && node src/cli.mjs evaluate-app-profile --json fixtures/sample-webapp-profile-scenarios.pkl | diff -u fixtures/reports/evaluate-app-profile-scenarios.json - && node src/cli.mjs evaluate-app-profile --json fixtures/sample-webapp-profile-extended-scenarios.pkl | diff -u fixtures/reports/evaluate-app-profile-extended-scenarios.json - && node src/cli.mjs evaluate-app-profile --markdown fixtures/sample-webapp-profile-extended-scenarios.pkl | diff -u fixtures/reports/evaluate-app-profile-extended-scenarios.md - && node src/cli.mjs coverage-app-profile-scenarios --json fixtures/sample-webapp-profile-extended-scenarios.pkl | diff -u fixtures/reports/coverage-app-profile-scenarios.json - && node src/cli.mjs score-app-profile-mutations --json fixtures/sample-webapp-profile-extended-scenarios.pkl | diff -u fixtures/reports/score-app-profile-mutations.json - && node src/cli.mjs replay-app-profile-changes --json fixtures/app-change-replay-corpus.pkl | diff -u fixtures/reports/replay-app-profile-changes.json - && node src/cli.mjs spec-reading-eval --json fixtures/spec-reading-eval-sample-webapp.pkl | diff -u fixtures/reports/spec-reading-eval-sample-webapp.json - && node src/cli.mjs spec-reading-eval --json --runner fixtures/spec-reading-agent-runner.pkl fixtures/spec-reading-eval-sample-webapp.pkl | diff -u fixtures/reports/spec-reading-agent-run.json - && node src/cli.mjs spec-reading-eval --json --refresh-digests fixtures/spec-reading-eval-stale-digest.pkl | diff -u fixtures/reports/spec-reading-eval-refresh-stale.json - && node src/cli.mjs spec-reading-eval-suite --json fixtures/spec-reading-eval-suite.pkl | diff -u fixtures/reports/spec-reading-eval-suite.json - && (node src/cli.mjs spec-reading-eval --json fixtures/spec-reading-eval-stale-digest.pkl 2>/dev/null || true) | diff -u fixtures/reports/spec-reading-eval-stale-digest.json - && node src/cli.mjs spec-reading-eval --markdown --score fixtures/spec-reading-eval-answers.json fixtures/spec-reading-eval-sample-webapp.pkl | diff -u fixtures/reports/spec-reading-eval-score.md - && node src/cli.mjs check-app-profile --json fixtures/sample-webapp-profile.pkl | diff -u fixtures/reports/check-app-profile-sample-webapp.json - && node src/cli.mjs check-app-profile-suite --json fixtures/sample-webapp-profile-suite.pkl | diff -u fixtures/reports/check-app-profile-suite.json - && node src/cli.mjs evaluate-app-profile-suite --json fixtures/sample-webapp-profile-suite.pkl | diff -u fixtures/reports/evaluate-app-profile-suite.json - && node src/cli.mjs check-app-profile --json fixtures/sample-webapp-profile.pkl fixtures/sample-webapp-profile.pkl fixtures/sample-webapp-profile.pkl fixtures/sample-webapp-profile.pkl fixtures/sample-webapp-profile.pkl fixtures/sample-webapp-profile.pkl fixtures/sample-webapp-profile.pkl fixtures/sample-webapp-profile.pkl | diff -u fixtures/reports/check-app-profile-scale.json - && (node src/cli.mjs domain-coverage --json fixtures/domain-coverage-orphan.pkl 2>/dev/null || true) | diff -u fixtures/reports/domain-coverage-orphan.json - && node src/cli.mjs impact --json fixtures/impact-before.pkl fixtures/impact-after.pkl | diff -u fixtures/reports/impact.json - && node src/cli.mjs spec-change compat --json fixtures/compat-before.pkl fixtures/compat-narrowing-after.pkl | diff -u fixtures/reports/spec-compat-narrowing.json - && node src/cli.mjs spec-change scaffold fixtures/compat-before.pkl fixtures/compat-narrowing-after.pkl | diff -u fixtures/spec-change-scaffold-narrowing.pkl - && node src/cli.mjs spec-change review --json fixtures/spec-change-review.pkl | diff -u fixtures/reports/spec-change-review.json - && node src/cli.mjs spec-change review --json fixtures/spec-change-review-breaking-approved.pkl | diff -u fixtures/reports/spec-change-review-breaking-approved.json - && (node src/cli.mjs spec-change review --json fixtures/spec-change-review-breaking-missing-evidence.pkl 2>/dev/null || true) | diff -u fixtures/reports/spec-change-review-breaking-missing-evidence.json - && (node src/cli.mjs coverage --json fixtures/coverage-missing-check.pkl 2>/dev/null || true) | diff -u fixtures/reports/coverage-missing-check.json - && node src/cli.mjs verify-generated --json fixtures/typed-ast.pkl | node scripts/project-verify-generated-fixture.mjs | diff -u fixtures/reports/verify-generated-typed-ast.json - && (node src/cli.mjs normalize-counterexamples --json --locale ja fixtures/coverage-missing-check.pkl 2>/dev/null || true) | node scripts/project-normalize-counterexamples-fixture.mjs | diff -u fixtures/reports/normalize-counterexamples-coverage-missing-check.json -"
  inputs = new {
    ...pklSources
    ...jsonFixtures
